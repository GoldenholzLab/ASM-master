effective_dose","proposed_value":"31-41 % (drug minus placebo seizure-freedom differential at maximum effective dose/regimen: Trevathan2006 lamotrigine individualized adjunctive dose 31%; Frank1999 lamotrigine monotherapy responder-enriched regimen 41%)","rationale":"Trevathan reports maintenance seizure freedom 48% vs 17%; Frank reports seizure freedom 62% vs 21%.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/16847080/","https://pubmed.ncbi.nlm.nih.gov/10403222/"]},{"current_value":"Naritoku2007|23.2|https://pubmed.ncbi.nlm.nih.gov/17938371/|239; Biton2005|23|https://pubmed.ncbi.nlm.nih.gov/16344515/|117; Motte1997|17|https://pubmed.ncbi.nlm.nih.gov/9400037/|169; Schapel1993|22|https://pubmed.ncbi.nlm.nih.gov/8505632/|41","field":"plot_diff_50_responder_maximum_effective_dose","proposed_value":"Naritoku2007|23.2|https://pubmed.ncbi.nlm.nih.gov/17938371/|239; Biton2005|23|https://pubmed.ncbi.nlm.nih.gov/16344515/|117; Motte1997|17|https://pubmed.ncbi.nlm.nih.gov/9400037/|169; Schapel1993|22|https://pubmed.ncbi.nlm.nih.gov/8505632/|41","rationale":"Plot entries match the verified RR50 summary values and PMIDs.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/17938371/","https://pubmed.ncbi.nlm.nih.gov/16344515/","https://pubmed.ncbi.nlm.nih.gov/9400037/","https://pubmed.ncbi.nlm.nih.gov/8505632/"]},{"current_value":"Biton2010|43.3|https://pubmed.ncbi.nlm.nih.gov/20937567/|153; Naritoku2007|22.1|https://pubmed.ncbi.nlm.nih.gov/17938371/|239; Trevathan2006|37|https://pubmed.ncbi.nlm.nih.gov/16847080/|45; Biton2005|32.3|https://pubmed.ncbi.nlm.nih.gov/16344515/|117; Motte1997|44.8|https://pubmed.ncbi.nlm.nih.gov/9400037/|169; Boas1996|30.3|https://pubmed.ncbi.nlm.nih.gov/8937535/|56; Messenheimer1994|25|https://pubmed.ncbi.nlm.nih.gov/8112232/|98","field":"plot_diff_median_pct_change_maximum_effective_dose","proposed_value":"Biton2010|43.3|https://pubmed.ncbi.nlm.nih.gov/20937567/|153; Naritoku2007|22.1|https://pubmed.ncbi.nlm.nih.gov/17938371/|239; Trevathan2006|37|https://pubmed.ncbi.nlm.nih.gov/16847080/|45; Biton2005|32.3|https://pubmed.ncbi.nlm.nih.gov/16344515/|117; Motte1997|44.8|https://pubmed.ncbi.nlm.nih.gov/9400037/|169; Boas1996|30.3|https://pubmed.ncbi.nlm.nih.gov/8937535/|56; Messenheimer1994|25|https://pubmed.ncbi.nlm.nih.gov/8112232/|98; Matsuo1993|28|https://pubmed.ncbi.nlm.nih.gov/8232944/|216","rationale":"Add missing Matsuo1993 MPC differential; existing plot entries are concordant with cited outcomes.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/8232944/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf"]},{"current_value":"Trevathan2006|31|https://pubmed.ncbi.nlm.nih.gov/16847080/|45; Frank1999|41|https://pubmed.ncbi.nlm.nih.gov/10403222/|45","field":"plot_diff_seizure_freedom_maximum_effective_dose","proposed_value":"Trevathan2006|31|https://pubmed.ncbi.nlm.nih.gov/16847080/|45; Frank1999|41|https://pubmed.ncbi.nlm.nih.gov/10403222/|45","rationale":"Plot entries match the verified seizure-freedom summary values.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/16847080/","https://pubmed.ncbi.nlm.nih.gov/10403222/"]}],"overall_status":"needs_update","proposed_row_updates":[{"current_value":"FDA/DailyMed SPL; status=boxed_warning_found; setid=d7e3572d-56fe-4727-2bb4-013ccca22678; published=Nov 17, 2025; title=LAMICTAL...; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=d7e3572d-56fe-4727-2bb4-013ccca22678","field":"fda_black_box_warning_source","proposed_value":"FDA/accessdata drug label; status=boxed_warning_found; application=NDA 020241/020764/022251; revised=10/2025; reference_id=5675542; title=LAMICTAL (lamotrigine) tablets/tablets for oral suspension/LAMICTAL ODT; url=https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf","reason":"DailyMed is not permissible for black-box-warning verification; FDA/accessdata supports the field.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf"]},{"current_value":"Up to 500 mg/day for adjunctive therapy depending on interacting ASMs","field":"maximum_approved_daily_dose","proposed_value":"Up to 500 mg/day for immediate-release adjunctive epilepsy depending on interacting ASMs; up to 600 mg/day for Lamictal XR adjunctive therapy depending on concomitant AEDs","reason":"Current value omits FDA-approved XR adjunctive dosing up to 600 mg/day.","requires_user_approval":true,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/022115s031s032lbl.pdf"]},{"current_value":"Glutamate receptor","field":"filter_mechanism","proposed_value":"Sodium channel; Reduced excitatory amino acid release","reason":"FDA label supports sodium-channel inhibition and reduced glutamate/aspartate release, not glutamate-receptor antagonism.","requires_user_approval":true,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf"]},{"current_value":"Conduction/arrhythmia caution; No known meaningful QT effect; QT prolongation","field":"filter_qt_effect","proposed_value":"Conduction/arrhythmia caution; No known meaningful QT effect","reason":"QT prolongation is not supported as a meaningful lamotrigine effect; conduction/arrhythmia caution is supported.","requires_user_approval":true,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf","https://www.fda.gov/drugs/drug-safety-and-availability/studies-show-increased-risk-heart-rhythm-problems-seizure-and-mental-health-medicine-lamotrigine"]},{"current_value":"","field"