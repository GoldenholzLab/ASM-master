s062%2C022251s032s033lbl.pdf"]},{"current_value":"Biton2010|43.3|https://pubmed.ncbi.nlm.nih.gov/20937567/|153; Naritoku2007|22.1|https://pubmed.ncbi.nlm.nih.gov/17938371/|239; Trevathan2006|37|https://pubmed.ncbi.nlm.nih.gov/16847080/|45; Biton2005|32.3|https://pubmed.ncbi.nlm.nih.gov/16344515/|117; Motte1997|44.8|https://pubmed.ncbi.nlm.nih.gov/9400037/|169; Boas1996|30.3|https://pubmed.ncbi.nlm.nih.gov/8937535/|56; Messenheimer1994|25|https://pubmed.ncbi.nlm.nih.gov/8112232/|98","field":"plot_diff_median_pct_change_maximum_effective_dose","proposed_value":"Biton2010|43.3|https://pubmed.ncbi.nlm.nih.gov/20937567/|153; Naritoku2007|22.1|https://pubmed.ncbi.nlm.nih.gov/17938371/|239; Trevathan2006|37|https://pubmed.ncbi.nlm.nih.gov/16847080/|45; Biton2005|32.3|https://pubmed.ncbi.nlm.nih.gov/16344515/|117; Motte1997|44.8|https://pubmed.ncbi.nlm.nih.gov/9400037/|169; Boas1996|30.3|https://pubmed.ncbi.nlm.nih.gov/8937535/|56; Messenheimer1994|25|https://pubmed.ncbi.nlm.nih.gov/8112232/|98; Matsuo1993|28|https://pubmed.ncbi.nlm.nih.gov/8232944/|216","reason":"Adds missing placebo-adjusted median percent reduction from the omitted Matsuo1993 randomized placebo-controlled trial.","requires_user_approval":false,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/8232944/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf"]}],"rct_link_checks":[{"label":"Biton2010","pmid":"20937567","proposed_action":"Keep.","rationale":"Lamotrigine XR; randomized double-blind placebo-controlled adjunctive PGTC seizure study; ClinicalTrials.gov links it to a Phase 3 randomized placebo-controlled trial.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/20937567/"},{"label":"Naritoku2007","pmid":"17938371","proposed_action":"Keep; disregard automated title-only warning.","rationale":"Abstract verifies randomized double-blind parallel-group adjunctive lamotrigine XR vs placebo for partial seizures; ClinicalTrials.gov NCT00113165 is Phase 3.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/17938371/"},{"label":"Trevathan2006","pmid":"16847080","proposed_action":"Keep.","rationale":"Randomized blinded placebo-controlled lamotrigine adjunctive PGTC trial report/subgroup in children and adolescents; reports MPC and seizure-freedom outcomes.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/16847080/"},{"label":"Pressler2006","pmid":"16717207","proposed_action":"User review before retaining in phase II/III efficacy list.","rationale":"Lamotrigine vs placebo randomized double-blind crossover in children with epilepsy, but primary endpoint is cognition and seizure frequency was similar; it does not support seizure efficacy outcomes.","status":"not_phase_ii_iii","url":"https://pubmed.ncbi.nlm.nih.gov/16717207/"},{"label":"Ettinger2006","pmid":"17071141","proposed_action":"User review before retaining as a separate phase II/III efficacy RCT.","rationale":"Secondary mood-symptom analysis of a randomized placebo-controlled PGTC study; does not provide independent seizure-efficacy outcomes for this row.","status":"not_phase_ii_iii","url":"https://pubmed.ncbi.nlm.nih.gov/17071141/"},{"label":"Biton2005","pmid":"16344515","proposed_action":"Keep.","rationale":"Double-blind placebo-controlled lamotrigine adjunctive trial in PGTC seizures; cited RR50 and MPC values match row outcome extraction.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/16344515/"},{"label":"Frank1999","pmid":"10403222","proposed_action":"Keep.","rationale":"Lamotrigine monotherapy for typical absence seizures; responder-enriched open-label phase followed by randomized placebo-controlled double-blind phase with seizure-freedom endpoint.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/10403222/"},{"label":"Duchowny1999","pmid":"10563619","proposed_action":"Keep.","rationale":"Placebo-controlled lamotrigine add-on therapy trial for partial seizures in children; no extractable row outcome percentages used.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/10563619/"},{"label":"Eriksson1998","pmid":"9596201","proposed_action":"Keep.","rationale":"Randomized double-blind crossover lamotrigine study in refractory generalized epilepsy; no RR50/MPC/SF value used in row outcome summaries.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/9596201/"},{"label":"Beran1998","pmid":"9860069","proposed_action":"Keep.","rationale":"Double-blind placebo-controlled crossover lamotrigine study in treatment-resistant generalized epilepsy; not used for plotted outcome differentials.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/9860069/"},{"label":"Motte1997","pmid":"9400037","proposed_action":"Keep.","rationale":"Randomized double-blind placebo-controlled LGS trial of lamotrigine; supports RR50 33% vs 16% and derived MPC differential.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/9400037/"},{"label":"Matsuo1996","pmid":"8814098","proposed_action":"Keep only as a safety/tolerability placebo-controlled trial, not as seizure efficacy evidence.","rationale":"Double-blind placebo-controlled high-dose tolerability/safety study in epilepsy; no RR50/MPC/SF outcome is used in row summaries.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/8814098/"},{"label":"Boas1996","pmid":"8937535","proposed_action":"Keep.","rationale":"Controlled lamotrigine trial for treatment-resistant partial seizures; supports the placebo-adjusted 30.3% seizure-count reduction used in MPC plot.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/8937535/"},{"label":"Messenheimer1994","pmid":"8112232","proposed_action":"Keep.","rationale":"Multicenter placebo-controlled double-blind crossover partial-seizure trial; FDA label also describes the n=98 trial and 25% reduction on lamotrigine compared with placebo.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/8112232/"},{"label":"Schapel1993","pmid":"8505632","proposed_action":"Keep.","rationale":"Double-blind placebo-controlled crossover trial in treatment-resistant partial seizures; supports RR50 differential extraction.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/8505632/"},{"label":"Sander1990","pmid":"2272345","proposed_action":"Keep as qualifying placebo-controlled add-on trial; do not use for plotted outcomes without extractable percentages.","rationale":"Randomized double-blind placebo-controlled add-on lamotrigine trial in severe epilepsy; abstract does not provide row outcome differentials.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/2272345/"},{"label":"Loiseau1990","pmid":"2127016","proposed_action":"Keep as qualifying placebo-controlled add-on trial; do not use for plotted outcomes without matching placebo percentages.","rationale":"Randomized double-blind placebo-controlled crossover add-on lamotrigine trial in treatment-resistant partial seizures; no plotted differential is extracted.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/2127016/"},{"label":"Jawad1986","pmid":"3530305","proposed_action":"User review before retaining in phase II/III clinical efficacy list.","rationale":"Lamotrigine pharmacodynamic/interictal spike-count study, not a seizure-frequency phase II/III efficacy outcome report.","status":"not_phase_ii_iii","url":"https://pubmed.ncbi.nlm.nih.gov/3530305/"}],"source_updates":[{"current_value":"FDA/DailyMed SPL; status=boxed_warning_found; setid=d7e3572d-56fe-4727-2bb4-013ccca22678; published=Nov 17, 2025; title=LAMICTAL...; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=d7e3572d-56fe-4727-2bb4-013ccca22678","field":"fda_black_box_warning_source","proposed_value":"FDA/accessdata drug label; status=boxed_warning_found; application=NDA 020241/020764/022251; revised=10/2025; reference_id=5675542; title=LAMICTAL (lamotrigine) tablets/tablets for oral suspension/LAMICTAL ODT; url=https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf","reason":"Black-box-warning verification must use FDA/openFDA/accessdata/Drugs@FDA sources, not DailyMed.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; Epilepsy Foundation Australia ASM list; FDA/DailyMed labeling; Sills and Rogawski 2020 ASM mechanism review","field":"evidence_sources","proposed_value":"FDA/accessdata labeling; eMC SmPC; NCBI/PubMed reviews; PubMed randomized placebo-controlled trial reports; ClinicalTrials.gov trial records; Sills and Rogawski 2020 ASM mechanism review","reason":"Replaces non-trusted or overbroad source names with trusted-domain sources that support the row facts.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf","https://www.medicines.org.uk/emc/product/8052/smpc","https://pmc.ncbi.nlm.nih.gov/articles/PMC10712213/","https://clinicaltrials.gov/study/NCT00104416","https://clinicaltrials.gov/study/NCT00113165"]},{"current_value":"FDA/DailyMed labeling; Sills and Rogawski 2020 ASM mechanism review","field":"mechanism_source","proposed_value":"FDA/accessdata labeling; Sills and Rogawski 2020 ASM mechanism review","reason":"DailyMed should be replaced by FDA/accessdata labeling in named row sources.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/020241s068s069%2C020764s061s062%2C022251s032s033lbl.pdf"]}],"summary":"Lamotrigine row is largely factually supported, including FDA approval year, US availability, adverse-event percentages, labeled formulations, mechanism text, half-life, glucuronidation metabolism, boxed-warning text, and most plotted RCT outcome values. Updates are needed for black-box source metadata, mechanism/QT filters, XR maximum daily dose, source hygiene, PubMed aliases, and missing Matsuo1993 RCT/outcome coverage. No duplicate separate-drug row is indicated for aliases."}
