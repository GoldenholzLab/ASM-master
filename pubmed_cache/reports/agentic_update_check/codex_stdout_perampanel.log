tps://pubmed.ncbi.nlm.nih.gov/26296511/","https://pubmed.ncbi.nlm.nih.gov/22905857/","https://pubmed.ncbi.nlm.nih.gov/22843280/","https://pubmed.ncbi.nlm.nih.gov/22517103/"]},{"current_value":"7.9-38.1 % (drug minus placebo MPC differential at maximum effective dose/regimen: Vossler2024 18.6%; Nishida2017 27.2%; Lagae2016 34%; French2015 38.1%; French2012b 7.9%; French2012 13.5%; Krauss2012 20.1%)","field":"diff_median_pct_change_maximum_effective_dose","proposed_value":"No change","rationale":"Differences match cited active minus placebo median percent reduction values: Vossler 23.1-4.5=18.6; Nishida 38.0-10.8=27.2; Lagae 58.0-24.0=34.0; French2015 76.5-38.4=38.1; French2012b 17.6-9.7=7.9; French2012 34.5-21.0=13.5; Krauss2012 30.8-10.7=20.1. Vossler’s prespecified comparison was underpowered/not statistically significant, but the numeric differential is correctly calculated.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/39576191/","https://pubmed.ncbi.nlm.nih.gov/29250772/","https://pubmed.ncbi.nlm.nih.gov/27221398/","https://pubmed.ncbi.nlm.nih.gov/26296511/","https://pubmed.ncbi.nlm.nih.gov/22905857/","https://pubmed.ncbi.nlm.nih.gov/22843280/","https://pubmed.ncbi.nlm.nih.gov/22517103/"]},{"current_value":"18.6 % (drug minus placebo seizure-freedom differential at maximum effective dose/regimen: French2015 perampanel up to 8 mg/day 18.6%)","field":"diff_seizure_freedom_maximum_effective_dose","proposed_value":"No change","rationale":"French2015 reports PGTC seizure freedom of 30.9% with perampanel and 12.3% with placebo; differential is 18.6 percentage points.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/26296511/"]},{"current_value":"plot_diff_50_responder_maximum_effective_dose; plot_diff_median_pct_change_maximum_effective_dose; plot_diff_seizure_freedom_maximum_effective_dose","field":"plot_diff_*","proposed_value":"No change","rationale":"Plot values match the corresponding verified outcome summary values and PubMed links.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/39576191/","https://pubmed.ncbi.nlm.nih.gov/29250772/","https://pubmed.ncbi.nlm.nih.gov/27221398/","https://pubmed.ncbi.nlm.nih.gov/26296511/","https://pubmed.ncbi.nlm.nih.gov/22517103/","https://pubmed.ncbi.nlm.nih.gov/22905857/","https://pubmed.ncbi.nlm.nih.gov/22843280/"]}],"overall_status":"needs_update","proposed_row_updates":[{"current_value":"FDA/DailyMed SPL; status=boxed_warning_found; setid=71cf3309-e182-473c-8b0b-280cabd0e122; published=Jan 28, 2026; title=FYCOMPA (PERAMPANEL) TABLET FYCOMPA (PERAMPANEL) SUSPENSION [EISAI INC.]; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=71cf3309-e182-473c-8b0b-280cabd0e122","field":"fda_black_box_warning_source","proposed_value":"FDA/Drugs@FDA label; status=boxed_warning_found; application=NDA 202834; label=2024/202834Orig1s019lbl.pdf; title=FYCOMPA (perampanel) tablets/oral suspension; url=https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf","reason":"DailyMed is not permissible for boxed-warning verification; FDA accessdata label supports the boxed warning.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf"]},{"current_value":"05-20-2026","field":"fda_black_box_warning_verified","proposed_value":"05-21-2026","reason":"Refresh the verification date if the FDA source update is applied.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; Epilepsy Foundation Australia ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA/Drugs@FDA labeling; NCBI LiverTox; PubMed placebo-controlled RCTs; ClinicalTrials.gov trial records","reason":"Replace non-trusted/non-preferred source names and add sources that support the RCT/outcome cells.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf","https://pubmed.ncbi.nlm.nih.gov/39576191/","https://clinicaltrials.gov/study/NCT00144690"]},{"current_value":"FDA/DailyMed labeling","field":"mechanism_source","proposed_value":"FDA/Drugs@FDA labeling","reason":"Mechanism is supported by FDA labeling; remove DailyMed from the named source.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf"]},{"current_value":"Vossler2024|https://pubmed.ncbi.nlm.nih.gov/39576191/; Nishida2017|https://pubmed.ncbi.nlm.nih.gov/29250772/; Lagae2016|https://pubmed.ncbi.nlm.nih.gov/27221398/; French2015|https://pubmed.ncbi.nlm.nih.gov/26296511/; Belousova2014|https://pubmed.ncbi.nlm.nih.gov/25345628/; Krauss2012|https://pubmed.ncbi.nlm.nih.gov/22517103/; French2012b|https://pubmed.ncbi.nlm.nih.gov/22905857/; French2012|https://pubmed.ncbi.nlm.nih.gov/22843280/","field":"pubmed_phase_ii_iii_rct_links","proposed_value":"Vossler2024|https://pubmed.ncbi.nlm.nih.gov/39576191/; Nishida2017|https://pubmed.ncbi.nlm.nih.gov/29250772/; Lagae2016|https://pubmed.ncbi.nlm.nih.gov/27221398/; Meador2016|https://pubmed.ncbi.nlm.nih.gov/26724782/; French2015|https://pubmed.ncbi.nlm.nih.gov/26296511/; Belousova2014|https://pubmed.ncbi.nlm.nih.gov/25345628/; Krauss2012|https://pubmed.ncbi.nlm.nih.gov/22517103/; French2012b|https://pubmed.ncbi.nlm.nih.gov/22905857/; French2012|https://pubmed.ncbi.nlm.nih.gov/22843280/","reason":"Meador2016 is a PubMed-indexed Phase II randomized placebo-controlled perampanel trial report. It should not alter outcome differentials.","requires_user_approval":false,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/26724782/"]},{"current_value":"PubMed loop 40/65 on 2026-05-15: 8 qualifying placebo-controlled randomized clinical trial report(s) retained from 50 PubMed candidate(s). Links were rebuilt from fetched PubMed PMID metadata and named FirstAuthorYear. Differential effectiveness columns summarize extractable maximum effective dose/regimen values within qualifying RCT reports.","field":"rct_pubmed_verification_notes","proposed_value":"Audit on 2026-05-21: existing efficacy/outcome RCT links and outcome differentials verified. Meador2016 (PMID 26724782) is an additional Phase II randomized placebo-controlled perampanel trial report but does not change RR50/MPC/seizure-freedom summaries. Yang2015 (PMID 26088895) supports QT assessment but should not be added as a seizure-efficacy RCT link.","reason":"Clarifies missing RCT coverage and rejects the Yang2015 add-to-RCT-link finding for this row’s seizure-efficacy RCT field.","requires_user_approval":false,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/26724782/","https://pubmed.ncbi.nlm.nih.gov/26088895/"]}],"rct_link_checks":[{"label":"Vossler2024","pmid":"39576191","proposed_action":"Keep","rationale":"Perampanel LGS randomized placebo-controlled Phase III trial; PMID and drug assignment are correct. Use for MPC only, with note that the prespecified drop-seizure comparison was underpowered/not statistically significant.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/39576191/"},{"label":"Nishida2017","pmid":"29250772","proposed_action":"Keep","rationale":"Randomized, double-blind, placebo-controlled Phase III adjunctive perampanel study in refractory partial-onset seizures; PMID and placebo control verified.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/29250772/"},{"label":"Lagae2016","pmid":"27221398","proposed_action":"Keep","rationale":"Randomized placebo-controlled perampanel adolescent partial-onset seizure trial; PMID, drug, design, and outcome use verified.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/27221398/"},{"label":"French2015","pmid":"26296511","proposed_action":"Keep","rationale":"Randomized placebo-controlled adjunctive perampanel trial for primary generalized tonic-clonic seizures; PMID, drug, design, and outcome values verified.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/26296511/"},{"label":"Belousova2014","pmid":"25345628","proposed_action":"Keep, but do not use for unique outcome extraction","rationale":"PubMed metadata identifies a Phase III randomized trial report/summary of international placebo-controlled perampanel studies. It appears secondary/duplicative of primary study reports and is not used in the outcome columns.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/25345628/"},{"label":"Krauss2012","pmid":"22517103","proposed_action":"Keep","rationale":"Randomized, double-blind, placebo-controlled Phase III study 306 of adjunctive perampanel for refractory partial-onset seizures; PMID and outcome values verified.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/22517103/"},{"label":"French2012b","pmid":"22905857","proposed_action":"Keep","rationale":"Randomized placebo-controlled Phase III study 305 of adjunctive perampanel for refractory partial-onset seizures; PMID and outcome values verified.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/22905857/"},{"label":"French2012","pmid":"22843280","proposed_action":"Keep","rationale":"Randomized placebo-controlled Phase III study 304 of adjunctive perampanel for refractory partial-onset seizures; PMID and outcome values verified.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/22843280/"}],"source_updates":[{"current_value":"FDA/DailyMed SPL; status=boxed_warning_found; setid=71cf3309-e182-473c-8b0b-280cabd0e122; published=Jan 28, 2026; title=FYCOMPA (PERAMPANEL) TABLET FYCOMPA (PERAMPANEL) SUSPENSION [EISAI INC.]; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=71cf3309-e182-473c-8b0b-280cabd0e122","field":"fda_black_box_warning_source","proposed_value":"FDA/Drugs@FDA label; status=boxed_warning_found; application=NDA 202834; label=2024/202834Orig1s019lbl.pdf; title=FYCOMPA (perampanel) tablets/oral suspension; url=https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf","reason":"DailyMed is not permissible for this field; FDA accessdata label is permissible.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf"]},{"current_value":"FDA/DailyMed labeling","field":"mechanism_source","proposed_value":"FDA/Drugs@FDA labeling","reason":"Use the FDA label source directly.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; Epilepsy Foundation Australia ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA/Drugs@FDA labeling; NCBI LiverTox; PubMed placebo-controlled RCTs; ClinicalTrials.gov trial records","reason":"Align source list with trusted-source policy and actual support for row facts.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/202834Orig1s019lbl.pdf","https://pubmed.ncbi.nlm.nih.gov/39576191/","https://clinicaltrials.gov/study/NCT00144690"]}],"summary":"Perampanel row facts are largely verified, including U.S. availability, Fycompa trade name, indications, formulations, mechanism, hepatic/CYP3A metabolism, half-life, QT statement, adverse-event percentages, FDA approval year, and the listed efficacy differentials. Updates are needed for source hygiene: replace DailyMed/non-trusted source wording with FDA/Drugs@FDA/PubMed/ClinicalTrials.gov sources, add Meador2016 as a missing placebo-controlled phase II RCT report if the RCT field includes non-efficacy trial reports, and do not add Yang2015 as a seizure-efficacy RCT link."}
