rce_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"Inhibitor","field":"filter_enzyme_effect","proposed_value":"Inducer; Inhibitor","reason":"Eslicarbazepine acetate has both induction and inhibition effects.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"Koepp2026|https://pubmed.ncbi.nlm.nih.gov/41722592/; Kirkham2020|https://pubmed.ncbi.nlm.nih.gov/32151803/; Mintzer2018|https://pubmed.ncbi.nlm.nih.gov/29499473/; Sperling2014|https://pubmed.ncbi.nlm.nih.gov/25528898/; BenMenachem2010|https://pubmed.ncbi.nlm.nih.gov/20299189/; GilNagel2009|https://pubmed.ncbi.nlm.nih.gov/19832771/; Elger2009|https://pubmed.ncbi.nlm.nih.gov/19243424/; Elger2007|https://pubmed.ncbi.nlm.nih.gov/17319919/","field":"pubmed_phase_ii_iii_rct_links","proposed_value":"Koepp2026|https://pubmed.ncbi.nlm.nih.gov/41722592/; Kirkham2020|https://pubmed.ncbi.nlm.nih.gov/32151803/; Mintzer2018|https://pubmed.ncbi.nlm.nih.gov/29499473/; Jozwiak2018|https://pubmed.ncbi.nlm.nih.gov/29454255/; Sperling2014|https://pubmed.ncbi.nlm.nih.gov/25528898/; BenMenachem2010|https://pubmed.ncbi.nlm.nih.gov/20299189/; GilNagel2009|https://pubmed.ncbi.nlm.nih.gov/19832771/; Elger2009|https://pubmed.ncbi.nlm.nih.gov/19243424/; Elger2007|https://pubmed.ncbi.nlm.nih.gov/17319919/","reason":"Add missing phase II randomized double-blind placebo-controlled pediatric focal-onset seizure study report.","requires_user_approval":false,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/29454255/","https://clinicaltrials.gov/study/NCT01527513"]},{"current_value":"PubMed loop 14/65 on 2026-05-15: 8 qualifying placebo-controlled randomized clinical trial report(s) retained from 33 PubMed candidate(s). Links were rebuilt from fetched PubMed PMID metadata and named FirstAuthorYear. Differential effectiveness columns summarize extractable maximum effective dose/regimen values within qualifying RCT reports.","field":"rct_pubmed_verification_notes","proposed_value":"Audit 2026-05-20: existing PubMed links verified as eslicarbazepine acetate phase II/III placebo-controlled randomized trial reports or secondary reports of such trials; added Jozwiak2018 (PMID 29454255) as a qualifying phase II randomized double-blind placebo-controlled pediatric study. Differential effectiveness columns retain extractable adult maximum effective-dose/regimen RR50/MPC values from Sperling2014, BenMenachem2010, GilNagel2009, Elger2009, and Elger2007; seizure-freedom differential remains not extractable.","reason":"Update RCT notes to reflect manual audit and the added missing trial report.","requires_user_approval":false,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/29454255/","https://pubmed.ncbi.nlm.nih.gov/25528898/","https://pubmed.ncbi.nlm.nih.gov/20299189/","https://pubmed.ncbi.nlm.nih.gov/19832771/","https://pubmed.ncbi.nlm.nih.gov/19243424/","https://pubmed.ncbi.nlm.nih.gov/17319919/"]}],"rct_link_checks":[{"label":"Koepp2026","pmid":"41722592","proposed_action":"Retain; do not use for RR50/MPC focal-seizure treatment outcome summaries.","rationale":"The cited article is a phase 2a randomized, double-blind, placebo-controlled eslicarbazepine acetate post-stroke seizure-prevention/antiepileptogenesis trial. It is not a focal-seizure frequency treatment trial with RR50/MPC endpoints.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/41722592/"},{"label":"Kirkham2020","pmid":"32151803","proposed_action":"Retain; do not use for adult maximum-dose RR50/MPC summary unless pediatric weight-based outcomes are separately extracted.","rationale":"The article is a phase III randomized, double-blind, placebo-controlled adjunctive eslicarbazepine acetate trial in children with refractory focal-onset seizures.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/32151803/"},{"label":"Mintzer2018","pmid":"29499473","proposed_action":"Retain only if secondary/post-hoc reports from placebo-controlled phase III trials are in scope; not an efficacy-outcome source for RR50/MPC.","rationale":"This is a post-hoc serum lipid analysis of pooled phase III randomized double-blind placebo-controlled adjunctive eslicarbazepine acetate trials in partial-onset seizures. It supports exposure to RCT data but not the effectiveness outcomes summarized in the row.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/29499473/"},{"label":"Sperling2014","pmid":"25528898","proposed_action":"Retain and continue using for RR50 outcome.","rationale":"Phase III randomized, double-blind, placebo-controlled trial of adjunctive eslicarbazepine acetate 800/1200 mg vs placebo in uncontrolled partial-onset seizures; RR50 at 1200 mg and placebo is reported.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/25528898/"},{"label":"BenMenachem2010","pmid":"20299189","proposed_action":"Retain and continue using for RR50 and MPC outcomes.","rationale":"Double-blind, randomized, placebo-controlled adjunctive eslicarbazepine acetate trial in adults with partial-onset seizures; reports responder and median relative seizure-frequency reduction values for 1200 mg and placebo.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/20299189/"},{"label":"GilNagel2009","pmid":"19832771","proposed_action":"Retain and continue using for RR50 and MPC outcomes.","rationale":"Phase III double-blind, randomized, placebo-controlled adjunctive eslicarbazepine acetate trial in adults with partial-onset seizures; reports responder and median relative seizure-frequency reduction values for 1200 mg and placebo.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/19832771/"},{"label":"Elger2009","pmid":"19243424","proposed_action":"Retain and continue using for RR50 and MPC outcomes.","rationale":"Phase III randomized, double-blind, placebo-controlled adjunctive eslicarbazepine acetate trial in adults with refractory partial-onset seizures; NCBI/PubMed-indexed citation and trial summaries support drug, design, and outcomes.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/19243424/"},{"label":"Elger2007","pmid":"17319919","proposed_action":"Retain and continue using for RR50 outcome; do not use for seizure-freedom differential because placebo rate is not extractable from abstract.","rationale":"Randomized, double-blind, placebo-controlled exploratory adjunctive trial of eslicarbazepine acetate/BIA 2-093 in adult partial-onset seizures; reports QD responder rate 54% vs placebo 28%.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/17319919/"}],"source_updates":[{"current_value":"FDA/DailyMed SPL; status=no_boxed_warning_in_selected_label; setid=3d0c9554-eaeb-4694-8089-00133fcadce3; published=Dec 05, 2023; title=APTIOM (ESLICARBAZEPINE ACETATE) TABLET APTIOM (ESLICARBAZEPINE ACETATE) KIT [SUMITOMO PHARMA AMERICA, INC.]; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=3d0c9554-eaeb-4694-8089-00133fcadce3","field":"fda_black_box_warning_source","proposed_value":"FDA/openFDA drug label API; status=no_boxed_warning_in_selected_fda_label; spl_set_id=3d0c9554-eaeb-4694-8089-00133fcadce3; effective_time=20231110; title=Aptiom / ESLICARBAZEPINE ACETATE; api_url=https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%223d0c9554-eaeb-4694-8089-00133fcadce3%22&limit=5","reason":"Boxed-warning verification must use FDA/openFDA/FDA labeling, not DailyMed.","requires_user_approval":false,"source_urls":["https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%223d0c9554-eaeb-4694-8089-00133fcadce3%22&limit=5"]},{"current_value":"FDA/DailyMed labeling","field":"mechanism_source","proposed_value":"FDA/accessdata labeling","reason":"Mechanism source should cite FDA labeling on a trusted FDA domain rather than DailyMed.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA/accessdata labeling; FDA/openFDA labeling; NCBI LiverTox; EMA Zebinix EPAR; eMC Zebinix SmPC; PubMed RCT records; ClinicalTrials.gov records","reason":"Replace non-trusted and policy-problem sources with trusted sources actually supporting the row facts.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%223d0c9554-eaeb-4694-8089-00133fcadce3%22&limit=5","https://www.ncbi.nlm.nih.gov/books/NBK548939/","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix","https://www.medicines.org.uk/emc/product/7872/smpc"]}],"summary":"Audit result: row is mostly supported for identity, aliases, availability, indication, dosing, mechanism, PK, QT, and adult efficacy outcomes. Updates are needed for FDA boxed-warning source policy, evidence source wording, adverse-event percentages, enzyme-effect filter, mechanism source wording, and a missing qualifying Jozwiak2018 PubMed RCT link. Existing adult RR50/MPC calculations are verified against cited RCT evidence; seizure-freedom differential remains not extractable."}
