{"black_box_warning":{"current_value":"No FDA boxed warning identified in selected current DailyMed label.","fda_source_urls":["https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%223d0c9554-eaeb-4694-8089-00133fcadce3%22&limit=5","https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"],"proposed_value":"No FDA boxed warning identified in selected current FDA/openFDA label.","rationale":"The no-boxed-warning conclusion is supported by FDA/openFDA/FDA label sources, but the current row uses DailyMed wording/source for the boxed-warning field, which violates the row policy.","requires_user_approval":false,"status":"incorrect"},"blocking_questions":[],"fact_checks":[{"current_value":"eslicarbazepine acetate","field":"generic_name","proposed_value":"eslicarbazepine acetate","rationale":"FDA, EMA, and eMC identify the active substance/generic as eslicarbazepine acetate.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"eslicarbazepine","field":"alternate_generic_names","proposed_value":"eslicarbazepine","rationale":"FDA labeling describes eslicarbazepine as the major active metabolite and EMA/eMC describe conversion from eslicarbazepine acetate to eslicarbazepine. This is an alias/metabolite term, not a separate medication row.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"BIA 2-093","field":"pubmed_search_aliases","proposed_value":"BIA 2-093","rationale":"BIA 2-093 is used in eslicarbazepine acetate trial records and older PubMed abstracts as the development code.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/17319919/","https://clinicaltrials.gov/study/NCT00988429"]},{"current_value":"Aptiom; Zebinix","field":"trade_names","proposed_value":"Aptiom; Zebinix","rationale":"Aptiom is the FDA-labeled US product; Zebinix is the EMA/eMC product for eslicarbazepine acetate.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"Yes","field":"available_in_us","proposed_value":"Yes","rationale":"Aptiom is an FDA-labeled eslicarbazepine acetate product.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"2013","field":"year_fda_cleared","proposed_value":"2013","rationale":"FDA label highlights state Initial U.S. Approval: 2013.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.accessdata.fda.gov/drugsatfda_docs/label/2013/022416s000lbl.pdf"]},{"current_value":"Focal","field":"epilepsy_type","proposed_value":"Focal","rationale":"FDA labeling uses partial-onset seizures; EMA/eMC uses partial-onset with or without secondary generalisation, which maps to focal-onset terminology.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix"]},{"current_value":"Tablet","field":"formulations_available","proposed_value":"Tablet","rationale":"US Aptiom labeling lists tablets in 200, 400, 600, and 800 mg strengths. EMA/eMC also list Zebinix tablets; EU Zebinix also has oral suspension, but the US formulation fact is tablet.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix"]},{"current_value":"Adults: 800-1600 mg once daily","field":"typical_doses_per_day","proposed_value":"Adults: 800-1600 mg once daily","rationale":"FDA labeling gives adult maintenance dosage of 800 mg to 1600 mg once daily.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"800 mg/day","field":"minimum_effective_dose","proposed_value":"800 mg/day","rationale":"FDA labeling gives 800 mg once daily as the lower recommended adult maintenance dose; adult adjunctive trials support efficacy at 800 mg in some pivotal studies.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://pubmed.ncbi.nlm.nih.gov/20299189/","https://pubmed.ncbi.nlm.nih.gov/19832771/"]},{"current_value":"1600 mg/day","field":"maximum_approved_daily_dose","proposed_value":"1600 mg/day","rationale":"FDA labeling gives adult maintenance dosage up to 1600 mg once daily.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"13-20 h","field":"half_life_range","proposed_value":"13-20 h","rationale":"FDA labeling reports apparent plasma half-life of eslicarbazepine as 13-20 hours in adult epilepsy patients.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"Liver hydrolysis/glucuronidation; renal excretion","field":"major_organ_for_metabolism","proposed_value":"Liver hydrolysis/glucuronidation; renal excretion","rationale":"Labeling describes rapid hydrolytic first-pass metabolism to eslicarbazepine, glucuronide metabolites, and primary renal excretion of metabolites.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"Weak CYP3A4/UGT inducer; inhibits CYP2C19","field":"enzyme_inducing_or_inhibiting","proposed_value":"Weak CYP3A4/UGT inducer; moderate CYP2C19 inhibitor","rationale":"FDA labeling supports CYP3A4 induction and CYP2C19 inhibition; eMC specifically characterizes eslicarbazepine as a weak CYP3A4/UGT inducer with CYP2C19 inhibiting properties.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"Converted to eslicarbazepine; precise mechanism is unknown but is thought to involve inhibition of voltage-gated sodium channels.","field":"mechanism_of_action","proposed_value":"Converted to eslicarbazepine; precise mechanism is unknown but is thought to involve inhibition of voltage-gated sodium channels.","rationale":"FDA labeling states Aptiom is extensively converted to eslicarbazepine and that the precise anticonvulsant mechanism is unknown but thought to involve voltage-gated sodium-channel inhibition.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"Moderate","field":"mechanism_confidence","proposed_value":"Moderate","rationale":"The confidence level is consistent with FDA wording that the precise mechanism is unknown while sodium-channel inhibition is the stated likely mechanism.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"FDA/DailyMed labeling","field":"mechanism_source","proposed_value":"FDA/accessdata labeling","rationale":"The mechanism is supported by FDA labeling; DailyMed is unnecessary and is not in the trusted source list for this audit.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"FDA label","field":"mechanism_source_tier","proposed_value":"FDA label","rationale":"FDA prescribing information is the correct tier for the mechanism claim.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"No clinically meaningful QT effect established","field":"qt_interval_effect","proposed_value":"No clinically meaningful QT effect established","rationale":"FDA labeling reports no significant QTc interval effect at tested Aptiom doses in a placebo- and active-controlled crossover study.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"CNS: dizziness 21-28%, CNS: somnolence 8-18%, GI: nausea 7-10%, neurologic: diplopia 6-11%, neurologic: ataxia 4-6%","field":"adverse_symptoms_percentages","proposed_value":"CNS: dizziness 20-28%, CNS: somnolence 11-18%, GI: nausea 10-16%, neurologic: diplopia 9-11%, neurologic: ataxia 4-6%","rationale":"FDA adult adjunctive placebo-controlled trial table for Aptiom 800 mg and 1200 mg reports dizziness 20/28%, somnolence 11/18%, nausea 10/16%, diplopia 9/11%, and ataxia 4/6%. Current values appear to mix or understate several active-dose percentages.","requires_user_approval":true,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA/accessdata labeling; FDA/openFDA labeling; NCBI LiverTox; EMA Zebinix EPAR; eMC Zebinix SmPC; PubMed RCT records; ClinicalTrials.gov records","rationale":"DailyMed and Epilepsy Society are not in the trusted source list for this audit, and DailyMed is explicitly impermissible for boxed-warning verification. The proposed sources cover the populated row facts with trusted domains.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%223d0c9554-eaeb-4694-8089-00133fcadce3%22&limit=5","https://www.ncbi.nlm.nih.gov/books/NBK548939/","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"Inhibitor","field":"filter_enzyme_effect","proposed_value":"Inducer; Inhibitor","rationale":"The drug has both induction and inhibition effects: CYP3A4/UGT induction and CYP2C19 inhibition.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"Available in US","field":"filter_availability","proposed_value":"Available in US","rationale":"Aptiom is FDA-labeled and marketed as a US product.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"Focal","field":"filter_epilepsy_type","proposed_value":"Focal","rationale":"Partial-onset seizures in the FDA/EMA labels correspond to focal-onset seizures.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix"]},{"current_value":"Tablet","field":"filter_formulation","proposed_value":"Tablet","rationale":"US Aptiom formulation is tablet.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"Sodium channel","field":"filter_mechanism","proposed_value":"Sodium channel","rationale":"FDA mechanism language supports voltage-gated sodium-channel inhibition as the likely mechanism.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"Liver/hepatic; Renal/no major metabolism","field":"filter_metabolism","proposed_value":"Liver/hepatic; Renal/no major metabolism","rationale":"The row category is broadly supported by first-pass hydrolysis/glucuronidation and renal excretion, though the wording is categorical rather than mechanistic.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"No known meaningful QT effect","field":"filter_qt_effect","proposed_value":"No known meaningful QT effect","rationale":"FDA labeling reports no significant QTc effect detected.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"CNS; GI; Neurologic","field":"filter_symptom_category","proposed_value":"CNS; GI; Neurologic","rationale":"The listed adverse events fall into CNS/neurologic and GI categories.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"Current ASM for focal/partial-onset seizures.","field":"status_or_notes","proposed_value":"Current ASM for focal/partial-onset seizures.","rationale":"FDA and EMA/eMC labeling support current use for partial-onset/focal-onset seizures.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix"]}],"generic_name":"eslicarbazepine acetate","missing_rcts":[{"pmid":"29454255","proposed_link_text":"Jozwiak2018|https://pubmed.ncbi.nlm.nih.gov/29454255/","title":"Effects of adjunctive eslicarbazepine acetate on neurocognitive functioning in children with refractory focal-onset seizures.","url":"https://pubmed.ncbi.nlm.nih.gov/29454255/","why_relevant":"Phase II randomized, double-blind, placebo-controlled pediatric adjunctive eslicarbazepine acetate study in refractory focal-onset seizures; it is a qualifying phase II placebo-controlled ASM trial report but is absent from the current PubMed RCT link field."}],"outcome_checks":[{"current_value":"15-26 % (drug minus placebo RR50 differential at maximum effective dose/regimen: Sperling2014 ESL 1200 mg/day 19.5%; BenMenachem2010 ESL 1200 mg/day 24.1%; GilNagel2009 ESL 1200 mg/day 15%; Elger2009 ESL 1200 mg/day 23%; Elger2007 ESL titrated to 1200 mg/day once daily 26%)","field":"diff_50_responder_maximum_effective_dose","proposed_value":"15-26 % (drug minus placebo RR50 differential at maximum effective dose/regimen: Sperling2014 ESL 1200 mg/day 19.5%; BenMenachem2010 ESL 1200 mg/day 24.1%; GilNagel2009 ESL 1200 mg/day 15%; Elger2009 ESL 1200 mg/day 23%; Elger2007 ESL titrated to 1200 mg/day once daily 26%)","rationale":"The cited maximum-dose RR50 differentials match reported active minus placebo responder rates: 42.6-23.1, 37.1-13.0, 38-23, 43-20, and 54-28.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/25528898/","https://pubmed.ncbi.nlm.nih.gov/20299189/","https://pubmed.ncbi.nlm.nih.gov/19832771/","https://pubmed.ncbi.nlm.nih.gov/19243424/","https://pubmed.ncbi.nlm.nih.gov/17319919/"]},{"current_value":"Sperling2014|19.5|https://pubmed.ncbi.nlm.nih.gov/25528898/|653; BenMenachem2010|24.1|https://pubmed.ncbi.nlm.nih.gov/20299189/|395; GilNagel2009|15|https://pubmed.ncbi.nlm.nih.gov/19832771/|252; Elger2009|23|https://pubmed.ncbi.nlm.nih.gov/19243424/|402; Elger2007|26|https://pubmed.ncbi.nlm.nih.gov/17319919/|143","field":"plot_diff_50_responder_maximum_effective_dose","proposed_value":"Sperling2014|19.5|https://pubmed.ncbi.nlm.nih.gov/25528898/|653; BenMenachem2010|24.1|https://pubmed.ncbi.nlm.nih.gov/20299189/|395; GilNagel2009|15|https://pubmed.ncbi.nlm.nih.gov/19832771/|252; Elger2009|23|https://pubmed.ncbi.nlm.nih.gov/19243424/|402; Elger2007|26|https://pubmed.ncbi.nlm.nih.gov/17319919/|143","rationale":"Plot values align with the RR50 differential summary and trial sample sizes reported for these adult trials.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/25528898/","https://pubmed.ncbi.nlm.nih.gov/20299189/","https://pubmed.ncbi.nlm.nih.gov/19832771/","https://pubmed.ncbi.nlm.nih.gov/19243424/","https://pubmed.ncbi.nlm.nih.gov/17319919/"]},{"current_value":"25-32 % (drug minus placebo MPC differential at maximum effective dose/regimen: BenMenachem2010 ESL 1200 mg/day 32%; GilNagel2009 ESL 1200 mg/day 25%; Elger2009 ESL 1200 mg/day 29%)","field":"diff_median_pct_change_maximum_effective_dose","proposed_value":"25-32 % (drug minus placebo MPC differential at maximum effective dose/regimen: BenMenachem2010 ESL 1200 mg/day 32%; GilNagel2009 ESL 1200 mg/day 25%; Elger2009 ESL 1200 mg/day 29%)","rationale":"Ben-Menachem reports median relative reduction 32.8% vs 0.8% placebo; Gil-Nagel reports 42% vs 17%; Elger 2009 reports 45% vs 16%, giving differentials of about 32, 25, and 29 percentage points.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/20299189/","https://pubmed.ncbi.nlm.nih.gov/19832771/","https://pubmed.ncbi.nlm.nih.gov/19243424/"]},{"current_value":"BenMenachem2010|32|https://pubmed.ncbi.nlm.nih.gov/20299189/|395; GilNagel2009|25|https://pubmed.ncbi.nlm.nih.gov/19832771/|252; Elger2009|29|https://pubmed.ncbi.nlm.nih.gov/19243424/|402","field":"plot_diff_median_pct_change_maximum_effective_dose","proposed_value":"BenMenachem2010|32|https://pubmed.ncbi.nlm.nih.gov/20299189/|395; GilNagel2009|25|https://pubmed.ncbi.nlm.nih.gov/19832771/|252; Elger2009|29|https://pubmed.ncbi.nlm.nih.gov/19243424/|402","rationale":"Plot values match the differential MPC summary and cited trial records.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/20299189/","https://pubmed.ncbi.nlm.nih.gov/19832771/","https://pubmed.ncbi.nlm.nih.gov/19243424/"]},{"current_value":"NR/not extractable as a drug-minus-placebo seizure-freedom patient-rate differential at the maximum effective dose/regimen from included phase II/III placebo-controlled RCT records","field":"diff_seizure_freedom_maximum_effective_dose","proposed_value":"NR/not extractable as a drug-minus-placebo seizure-freedom patient-rate differential at the maximum effective dose/regimen from included phase II/III placebo-controlled RCT records","rationale":"Elger2007 reports seizure-free patients in active QD/BID groups but does not report an extractable placebo rate in the abstract; the adult efficacy abstracts used for RR50/MPC do not provide a consistent maximum-dose drug-minus-placebo seizure-freedom differential.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/17319919/","https://pubmed.ncbi.nlm.nih.gov/25528898/","https://pubmed.ncbi.nlm.nih.gov/20299189/","https://pubmed.ncbi.nlm.nih.gov/19832771/","https://pubmed.ncbi.nlm.nih.gov/19243424/"]},{"current_value":"","field":"plot_diff_seizure_freedom_maximum_effective_dose","proposed_value":"","rationale":"No extractable seizure-freedom differential was verified from the included maximum effective-dose RCT abstracts, so an empty plot field is appropriate.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/17319919/","https://pubmed.ncbi.nlm.nih.gov/25528898/","https://pubmed.ncbi.nlm.nih.gov/20299189/","https://pubmed.ncbi.nlm.nih.gov/19832771/","https://pubmed.ncbi.nlm.nih.gov/19243424/"]}],"overall_status":"needs_update","proposed_row_updates":[{"current_value":"CNS: dizziness 21-28%, CNS: somnolence 8-18%, GI: nausea 7-10%, neurologic: diplopia 6-11%, neurologic: ataxia 4-6%","field":"adverse_symptoms_percentages","proposed_value":"CNS: dizziness 20-28%, CNS: somnolence 11-18%, GI: nausea 10-16%, neurologic: diplopia 9-11%, neurologic: ataxia 4-6%","reason":"Align adult adjunctive adverse-event percentages to FDA labeling for Aptiom 800 and 1200 mg.","requires_user_approval":true,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA/accessdata labeling; FDA/openFDA labeling; NCBI LiverTox; EMA Zebinix EPAR; eMC Zebinix SmPC; PubMed RCT records; ClinicalTrials.gov records","reason":"Replace non-trusted or policy-problem source wording with trusted sources used for the row.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2017/022416s009lbl.pdf","https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%223d0c9554-eaeb-4694-8089-00133fcadce3%22&limit=5","https://www.ncbi.nlm.nih.gov/books/NBK548939/","https://www.ema.europa.eu/en/medicines/human/EPAR/zebinix","https://www.medicines.org.uk/emc/product/7872/smpc"]},{"current_value":"No FDA boxed warning identified in selected current DailyMed label.","field":"fda_black_box_warning","proposed_value":"No FDA boxed warning identified in selected 