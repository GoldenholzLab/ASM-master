v/books/NBK2597/","https://www.ncbi.nlm.nih.gov/books/NBK544244/"]},{"current_value":"No current FDA/DailyMed label identified.","field":"fda_black_box_warning","proposed_value":"No current FDA/openFDA label identified.","reason":"Boxed-warning verification must use FDA/openFDA, not DailyMed.","requires_user_approval":false,"source_urls":["https://api.fda.gov/drug/label.json?search=openfda.generic_name:%22phensuximide%22&limit=1","https://api.fda.gov/drug/label.json?search=openfda.brand_name:%22MILONTIN%22&limit=1"]}],"rct_link_checks":[],"source_updates":[{"current_value":"FDA Orange Book products file; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA/openFDA Drugs@FDA application endpoint; FDA/openFDA label API; FDA Orange Book data files; PubMed/NCBI Bookshelf","reason":"DailyMed is not permissible for boxed-warning verification, and non-FDA trusted sources are needed for aliases, epilepsy type, and half-life.","requires_user_approval":false,"source_urls":["https://api.fda.gov/drug/drugsfda.json?search=application_number:%22NDA008855%22&limit=5","https://api.fda.gov/drug/label.json?search=openfda.generic_name:%22phensuximide%22&limit=1","https://pubmed.ncbi.nlm.nih.gov/116142/","https://www.ncbi.nlm.nih.gov/books/NBK2597/"]},{"current_value":"FDA/DailyMed search on 05-20-2026: no current label found for terms [phensuximide; Milontin].","field":"fda_black_box_warning_source","proposed_value":"FDA/openFDA label API searches on 2026-05-21: no current FDA label found for openfda.generic_name:\"phensuximide\" or openfda.brand_name:\"MILONTIN\".","reason":"Replace DailyMed wording with FDA/openFDA-only boxed-warning source wording.","requires_user_approval":false,"source_urls":["https://api.fda.gov/drug/label.json?search=openfda.generic_name:%22phensuximide%22&limit=1","https://api.fda.gov/drug/label.json?search=openfda.brand_name:%22MILONTIN%22&limit=1"]},{"current_value":"05-20-2026","field":"fda_black_box_warning_verified","proposed_value":"05-21-2026","reason":"Reflects the FDA/openFDA label API verification date used in this audit.","requires_user_approval":false,"source_urls":["https://api.fda.gov/drug/label.json?search=openfda.generic_name:%22phensuximide%22&limit=1"]},{"current_value":"FDA Orange Book products file","field":"mechanism_source","proposed_value":"NCBI Bookshelf succinimide class discussion; PubMed PMID 116142; FDA/openFDA Drugs@FDA for product identity","reason":"Orange Book/product data do not support mechanism text; NCBI/PubMed support only a limited class-level mechanism.","requires_user_approval":false,"source_urls":["https://www.ncbi.nlm.nih.gov/books/NBK2597/","https://pubmed.ncbi.nlm.nih.gov/116142/"]}],"summary":"Audit found the row is broadly correct that Milontin/phensuximide is a discontinued historical U.S. FDA product with no current FDA/openFDA label and no qualifying phase II/III placebo-controlled epilepsy RCT. Updates are needed to remove DailyMed from boxed-warning sourcing, replace the legacy approval placeholder with the exact FDA approval date, add missing aliases, correct half-life from PubMed PMID 116142, and refine epilepsy/mechanism wording with limited PubMed/NCBI support."}
