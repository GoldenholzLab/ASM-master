s":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf","https://www.ema.europa.eu/en/documents/psusa/methylphenobarbital-list-nationally-authorised-medicinal-products-psusa-00002025-202303_en.pdf"]},{"current_value":"HALMED SmPC: adults 200-400 mg/day once daily or divided; children under 5 years 15-30 mg 3-4 times/day; children over 5 years 30-60 mg 3-4 times/day.","field":"typical_doses_per_day","proposed_value":"HALMED SmPC: adults 200-400 mg/day once daily or divided; children under 5 years 15-30 mg 3-4 times/day; children over 5 years 30-60 mg 3-4 times/day.","rationale":"Dose ranges and schedules match HALMED SmPC section 4.2.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf"]},{"current_value":"HALMED SmPC: start with the lowest dose and titrate over several days; adult recommended range begins at 200 mg/day.","field":"minimum_effective_dose","proposed_value":"HALMED SmPC: start with the lowest dose and titrate over several days; adult recommended range begins at 200 mg/day.","rationale":"HALMED SmPC says treatment starts with the lowest dose and is increased over several days; adult recommended daily dose begins at 200 mg/day.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf"]},{"current_value":"HALMED SmPC: 600 mg/day maximum in adults.","field":"maximum_approved_daily_dose","proposed_value":"HALMED SmPC: 600 mg/day maximum in adults.","rationale":"HALMED SmPC states adult maximum daily dose is 600 mg.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf"]},{"current_value":"About 75 h in children; about 100 h in adults","field":"half_life_range","proposed_value":"About 75 h in children; about 100 h in adults","rationale":"HALMED SmPC pharmacokinetics section gives elimination half-life about 75 hours in children and 100 hours in adults.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf"]},{"current_value":"Liver; N-demethylation to phenobarbital; partial renal excretion","field":"major_organ_for_metabolism","proposed_value":"Liver; N-demethylation to phenobarbital; partial renal excretion","rationale":"HALMED SmPC states methylphenobarbital is degraded by N-demethylation via hepatic microsomal enzymes to phenobarbital, with about 25% excreted unchanged in urine and the rest as glucuronide-linked metabolites.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf"]},{"current_value":"Enzyme inducer: barbiturate induction of hepatic microsomal enzymes, including CYP3A4-related interactions.","field":"enzyme_inducing_or_inhibiting","proposed_value":"Enzyme inducer: barbiturate induction of hepatic microsomal enzymes, including CYP3A4-related interactions.","rationale":"HALMED SmPC describes barbiturate induction of microsomal/hepatic enzymes and CYP3A4-related interaction with gefitinib; NCBI LiverTox states barbiturates are potent inducers of many hepatic enzymes, including CYP3A4.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf","https://www.ncbi.nlm.nih.gov/books/NBK548260/"]},{"current_value":"Barbiturate related to phenobarbital and metabolized partly to phenobarbital; HALMED SmPC attributes anticonvulsant effect to effects on CNS impulse transmission, increased motor-cortex electrical threshold, and possible enhancement of GABA-mediated inhibitory synaptic activity.","field":"mechanism_of_action","proposed_value":"Barbiturate related to phenobarbital and metabolized partly to phenobarbital; HALMED SmPC attributes anticonvulsant effect to effects on CNS impulse transmission, increased motor-cortex electrical threshold, and possible enhancement of GABA-mediated inhibitory synaptic activity.","rationale":"Mechanism language matches HALMED SmPC pharmacodynamics and pharmacokinetics sections.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf"]},{"current_value":"Moderate","field":"mechanism_confidence","proposed_value":"Moderate","rationale":"Moderate is appropriate because the SmPC supports GABA-related/barbiturate mechanism language but phrases GABA enhancement as possible rather than definitive for methylphenobarbital specifically.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf"]},{"current_value":"HALMED Phemiton 200 mg SmPC (https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf)","field":"mechanism_source","proposed_value":"HALMED Phemiton 200 mg SmPC (https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf)","rationale":"The cited SmPC directly supports the mechanism text.","requires_user_approval":false,"status":"verified","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf"]},{"current_value":"EMA/UK SmPC","field":"mechanism_source_tier","proposed_value":"National SmPC (HALMED/Croatia)","rationale":"The mechanism source is a Croatian HALMED SmPC, not an EMA SmPC or UK/eMC SmPC. EMA PSUSA supports national authorization but not the mechanism wording.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://halmed.hr/upl/lijekovi/SPC/Phemiton-200-mg-tablete-SPC.pdf","https://www.ema.europa.eu/en/documents/psusa/methylphenobarbital-list-nationally-authorised-medicinal-products-psusa-00002025-202303_en.pdf"]},{"current_value":"No QT interval effect described in HALMED SmPC; caution with impaired cardiac function and interacting cardiovascular drugs."