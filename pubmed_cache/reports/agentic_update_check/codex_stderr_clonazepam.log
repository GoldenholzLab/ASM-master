]},{"current_value":"Benzodiazepine positive allosteric modulator of GABA-A receptors; enhances GABAergic inhibition by binding at the benzodiazepine site.","field":"mechanism_of_action; filter_mechanism; mechanism_confidence","proposed_value":"Benzodiazepine positive allosteric modulator of GABA-A receptors; enhances GABAergic inhibition by binding at the benzodiazepine site.","rationale":"FDA labeling and NCBI/PubMed mechanism sources support GABAergic enhancement for clonazepam/benzodiazepines. High confidence is appropriate.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf","https://www.ncbi.nlm.nih.gov/books/NBK556010/","https://pubmed.ncbi.nlm.nih.gov/32120063/"]},{"current_value":"American Epilepsy Society 2024 U.S. ASM summary; Sills and Rogawski 2020 ASM mechanism review","field":"mechanism_source","proposed_value":"FDA Klonopin label; Sills and Rogawski 2020 ASM mechanism review; NCBI Bookshelf StatPearls clonazepam","rationale":"The current mechanism statement is supportable, but the retained source list should use trusted/cited domains. AES is not in the provided trusted domain list; FDA, PubMed, and NCBI sources are sufficient.","requires_user_approval":false,"status":"missing_source","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf","https://pubmed.ncbi.nlm.nih.gov/32120063/","https://www.ncbi.nlm.nih.gov/books/NBK556010/"]},{"current_value":"AES/FDA summary","field":"mechanism_source_tier","proposed_value":"FDA label/PubMed/NCBI","rationale":"The current tier names FDA but the mechanism_source field does not cite FDA; use a tier matching the actual trusted sources.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf","https://pubmed.ncbi.nlm.nih.gov/32120063/"]},{"current_value":"30-40 h; Liver; Liver/hepatic","field":"half_life_range; major_organ_for_metabolism; filter_metabolism","proposed_value":"30-40 h; Liver; Liver/hepatic","rationale":"FDA labeling states clonazepam is highly metabolized and has a typical elimination half-life of 30 to 40 hours.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"Not a CYP inducer/inhibitor","field":"enzyme_inducing_or_inhibiting; filter_enzyme_effect","proposed_value":"No major enzyme induction established; CYP3A may play an important role in clonazepam metabolism; effect on metabolism of other drugs has not been fully investigated","rationale":"FDA labeling supports no evidence that clonazepam induces its own metabolism or that of other drugs, but it does not establish a blanket 'not an inhibitor' statement and notes CYP3A involvement.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"Adults seizure disorders: 1.5 mg/day initial; titrate to effect; maximum 20 mg/day; maintenance often 1.5-20 mg/day divided TID","field":"minimum_effective_dose; maximum_approved_daily_dose; typical_doses_per_day","proposed_value":"Adults seizure disorders: initial dose should not exceed 1.5 mg/day divided TID; increase by 0.5 to 1 mg every 3 days until controlled or limited by adverse effects; maintenance individualized; maximum recommended daily dose 20 mg/day","rationale":"FDA labeling supports the initial dose, titration increments, individualized maintenance, and 20 mg/day maximum. It does not support 'maintenance often 1.5-20 mg/day' as written.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"CNS: drowsiness 50%, neurologic: ataxia 30%, behavioral: behavior problems 25%, respiratory: increased salivation 7%","field":"adverse_symptoms_percentages; filter_symptom_category","proposed_value":"CNS: drowsiness approximately 50%; neurologic: ataxia approximately 30%; behavioral: behavior problems approximately 25%; respiratory: hypersecretion in upper respiratory passages and hypersalivation/increased salivation warning, frequency not stated in FDA label","rationale":"FDA labeling supports drowsiness about 50%, ataxia about 30%, and behavior problems about 25% in seizure-disorder experience. The FDA label supports hypersalivation/increased salivation and upper-respiratory hypersecretion but not a 7% frequency.","requires_user_approval":true,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"No clinically meaningful QT effect established; No known meaningful QT effect","field":"qt_interval_effect; filter_qt_effect","proposed_value":"No QT warning identified in FDA labeling; clinically meaningful QT effect not established from reviewed trusted sources","rationale":"No QT warning was identified in the FDA label reviewed, but the current row lacks a direct trusted source proving absence of a clinically meaningful QT effect.","requires_user_approval":false,"status":"missing_source","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"1975","field":"year_fda_cleared","proposed_value":"1975","rationale":"Klonopin/clonazepam NDA 017533 is listed in Drugs@FDA resources; a label-only concordance check is not sufficient because labels do not necessarily carry original approval dates.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/scripts/cder/daf/index.cfm?event=overview.process&ApplNo=017533","https://www.fda.gov/drugs/drug-approvals-and-databases/drugsfda-data-files"]},{"current_value":"Current benzodiazepine used for seizure types including absence/myoclonic seizures; also used for panic/anxiety disorders.","field":"status_or_notes","proposed_value":"Current benzodiazepine used for specified seizure disorders including Lennox-Gastaut/petit mal variant, akinetic, myoclonic, and refractory absence seizures; also FDA-approved for panic disorder.","rationale":"FDA labeling supports specified seizure disorders and panic disorder. 'Panic/anxiety disorders' is broader than the FDA-labeled psychiatric indication.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Foundation Australia ASM list; Wikipedia anticonvulsant drug-class list; American Epilepsy Society 2024 U.S. ASM summary; Sills and Rogawski 2020 ASM mechanism review; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA/openFDA labeling; FDA Drugs@FDA; FDA benzodiazepine Drug Safety Communication; FDA/accessdata Klonopin label; NCBI Bookshelf StatPearls clonazepam; PubMed Sills and Rogawski 2020 mechanism review; PubMed/ClinicalTrials.gov records for cited RCTs; FDA warning letter noting non-U.S. Rivotril clonazepam product naming","rationale":"Wikipedia and Epilepsy Foundation Australia are outside the supplied trusted domains; DailyMed cannot be used for black-box verification. Use FDA, PubMed, NCBI, and ClinicalTrials.gov sources that support the specific cells.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf","https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%22cfa0d79a-843c-4b88-95a1-e9511d649ca1%22&limit=5","https://www.fda.gov/drugs/drug-safety-and-availability/fda-requiring-boxed-warning-updated-improve-safe-use-benzodiazepine-drug-class","https://www.ncbi.nlm.nih.gov/books/NBK556010/","https://pubmed.ncbi.nlm.nih.gov/32120063/","https://clinicaltrials.gov/study/NCT01150331"]}],"generic_name":"clonazepam","missing_rcts":[],"outcome_checks":[{"current_value":"NR/not extractable as drug-minus-placebo RR50, MPC, or seizure-freedom differentials from included phase II/III placebo-controlled RCT records","field":"diff_50_responder_maximum_effective_dose; diff_median_pct_change_maximum_effective_dose; diff_seizure_freedom_maximum_effective_dose","proposed_value":"Keep NR/not extractable","rationale":"Navarro/SAMUKeppra tested levetiracetam added to clonazepam versus placebo added to clonazepam, so no clonazepam-minus-placebo differential exists. Dahlin2000 measured epileptiform EEG activity rather than RR50, median percent seizure-frequency change, or seizure-freedom outcomes.","requires_user_approval":false,"status":"verified","supporting_sources":["https://clinicaltrials.gov/study/NCT01150331","https://pubmed.ncbi.nlm.nih.gov/26627366/","https://pubmed.ncbi.nlm.nih.gov/10714402/","https://www.ncbi.nlm.nih.gov/books/NBK579009/","https://www.ncbi.nlm.nih.gov/books/NBK581157/"]}],"overall_status":"needs_update","proposed_row_updates":[{"current_value":"FDA/DailyMed SPL; status=boxed_warning_found; setid=cfa0d79a-843c-4b88-95a1-e9511d649ca1; published=Dec 02, 2025; title=KLONOPIN (CLONAZEPAM) TABLET [H2-PHARMA, LLC]; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=cfa0d79a-843c-4b88-95a1-e9511d649ca1","field":"fda_black_box_warning_source","proposed_value":"FDA/openFDA drug label API; status=boxed_warning_found; spl_set_id=cfa0d79a-843c-4b88-95a1-e9511d649ca1; effective_time=20251201; title=Klonopin / CLONAZEPAM; api_url=https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%22cfa0d79a-843c-4b88-95a1-e9511d649ca1%22&limit=5; FDA label fallback=https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf","reason":"DailyMed is not permissible for black-box warning verification; FDA/openFDA or Drugs@FDA/accessdata is required.","requires_user_approval":false,"source_urls":["https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%22cfa0d79a-843c-4b88-95a1-e9511d649ca1%22&limit=5","https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"Absence; Myoclonic; Akinetic/atonic; Adjunctive nonspecific epilepsy","field":"epilepsy_type","proposed_value":"Lennox-Gastaut syndrome (petit mal variant); Akinetic; Myoclonic; Absence seizures after failure to respond to succinimides","reason":"FDA indication is specific and does not support broad 'adjunctive nonspecific epilepsy'.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"Not a CYP inducer/inhibitor","field":"enzyme_inducing_or_inhibiting","proposed_value":"No major enzyme induction established; CYP3A may play an important role in clonazepam metabolism; effect on metabolism of other drugs has not been fully investigated","reason":"Current wording overstates the FDA label evidence regarding inhibition.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"CNS: drowsiness 50%, neurologic: ataxia 30%, behavioral: behavior problems 25%, respiratory: increased salivation 7%","field":"adverse_symptoms_percentages","proposed_value":"CNS: drowsiness approximately 50%; neurologic: ataxia approximately 30%; behavioral: behavior problems approximately 25%; respiratory: hypersecretion in upper respiratory passages and hypersalivation/increased salivation warning, frequency not stated in FDA label","reason":"The 7% salivation value was not verified in the FDA label; the other percentages were verified.","requires_user_approval":true,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"Adults seizure disorders: maintenance often 1.5-20 mg/day divided TID","field":"typical_doses_per_day","proposed_value":"Adults seizure disorders: initial dose should not exceed 1.5 mg/day divided TID; increase by 0.5 to 1 mg every 3 days until controlled or limited by adverse effects; maintenance individualized; maximum recommended daily dose 20 mg/day","reason":"FDA label supports individualized maintenance and maximum 20 mg/day, not 'maintenance often 1.5-20 mg/day'.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"Navarro2015|https://pubmed.ncbi.nlm.nih.gov/26627366/; Dahlin2000|https://pubmed.ncbi.nlm.nih.gov/10714402/","field":"pubmed_phase_ii_iii_rct_links","proposed_value":"","reason":"The cited records do not qualify as phase II/III placebo-controlled clonazepam-vs-placebo seizure-frequency efficacy RCTs for this row. Navarro is a levetiracetam add-on trial with clonazepam in both arms; Dahlin is a low-dose EEG crossover study, not phase II/III RR50/MPC/seizure-freedom evidence.","requires_user_approval":true,"source_urls":["https://clinicaltrials.gov/study/NCT01150331","https://pubmed.ncbi.nlm.nih.gov/26627366/","https://pubmed.ncbi.nlm.nih.gov/10714402/","https://www.ncbi.nlm.nih.gov/books/NBK581157/"]},{"current_value":"PubMed loop 10/65 on 2026-05-15: 2 qualifying placebo-controlled randomized clinical trial report(s) retained from 11 PubMed candidate(s). Links were rebuilt from fetched PubMed PMID metadata and named FirstAuthorYear. Differential effectiveness columns summarize extractable maximum effective dose/regimen values within qualifying RCT reports.","field":"rct_pubmed_verification_notes","proposed_value":"Audit 2026-05-20: The cited records do not provide clonazepam-vs-placebo RR50, median percent seizure-frequency change, or seizure-freedom outcomes. Navarro2015/SAMUKeppra is a phase 3 levetiracetam add-on trial in which both arms received clonazepam; placebo controls levetiracetam, not clonazepam. Dahlin2000 is a randomized double-blind low-dose clonazepam EEG study measuring epileptiform activity, not phase II/III seizure-frequency RR50/MPC/seizure-freedom outcomes.","reason":"Current notes incorrectly describe both records as qualifying clonazepam placebo-controlled RCT reports for extractable effectiveness summaries.","requires_user_approval":true,"source_urls":["https://clinicaltrials.gov/study/NCT01150331","https://pubmed.ncbi.nlm.nih.gov/26627366/","https://pubmed.ncbi.nlm.nih.gov/10714402/","https://www.ncbi.nlm.nih.gov/books/NBK579009/","https://www.ncbi.nlm.nih.gov/books/NBK581157/"]}],"rct_link_checks":[{"label":"Navarro2015","pmid":"26627366","proposed_action":"Do not count as a qualifying clonazepam placebo-controlled efficacy RCT; remove from pubmed_phase_ii_iii_rct_links or move to notes with user approval.","rationale":"ClinicalTrials.gov and secondary PubMed/NCBI records identify this as a randomized, double-blind phase 3 placebo-controlled trial of levetiracetam added to clonazepam versus placebo added to clonazepam. Clonazepam was given in both arms, so no clonazepam-placebo effect is tested.","status":"wrong_drug","url":"https://pubmed.ncbi.nlm.nih.gov/26627366/"},{"label":"Dahlin2000","pmid":"10714402","proposed_action":"Do not count as a qualifying phase II/III placebo-controlled clonazepam seizure-frequency efficacy RCT; remove from the qualifying RCT field or move to notes with user approval.","rationale":"The record is a randomized double-blind low-dose clonazepam study in children with epilepsy, but evidence reviews describe it as a crossover/EEG epileptiform-activity study rather than a phase II/III seizure-frequency RCT with RR50, MPC, or seizure-freedom outcomes.","status":"not_phase_ii_iii","url":"https://pubmed.ncbi.nlm.nih.gov/10714402/"}],"source_updates":[{"current_value":"FDA/DailyMed SPL; status=boxed_warning_found; setid=cfa0d79a-843c-4b88-95a1-e9511d649ca1; published=Dec 02, 2025; title=KLONOPIN (CLONAZEPAM) TABLET [H2-PHARMA, LLC]; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=cfa0d79a-843c-4b88-95a1-e9511d649ca1","field":"fda_black_box_warning_source","proposed_value":"FDA/openFDA drug label API; status=boxed_warning_found; spl_set_id=cfa0d79a-843c-4b88-95a1-e9511d649ca1; effective_time=20251201; title=Klonopin / CLONAZEPAM; api_url=https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%22cfa0d79a-843c-4b88-95a1-e9511d649ca1%22&limit=5","reason":"Black-box warnings must be verified from FDA/openFDA, FDA labels, or Drugs@FDA, not DailyMed.","requires_user_approval":false,"source_urls":["https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%22cfa0d79a-843c-4b88-95a1-e9511d649ca1%22&limit=5","https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Foundation Australia ASM list; Wikipedia anticonvulsant drug-class list; American Epilepsy Society 2024 U.S. ASM summary; Sills and Rogawski 2020 ASM mechanism review; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA/openFDA labeling; FDA Drugs@FDA; FDA benzodiazepine Drug Safety Communication; FDA/accessdata Klonopin label; NCBI Bookshelf StatPearls clonazepam; PubMed Sills and Rogawski 2020 mechanism review; PubMed/ClinicalTrials.gov records for cited RCTs; FDA warning letter noting non-U.S. Rivotril clonazepam product naming","reason":"Several current sources are not in the trusted domain list or do not support specific cells. DailyMed is not acceptable for black-box verification.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2023/017533s062lbl.pdf","https://www.fda.gov/drugs/drug-approvals-and-databases/drugsfda-data-files","https://www.fda.gov/drugs/drug-safety-and-availability/fda-requiring-boxed-warning-updated-improve-safe-use-benzodiazepine-drug-class","https://www.ncbi.nlm.nih.gov/books/NBK556010/","https://pubmed.ncbi.nlm.nih.gov/32120063/","https://clinicaltrials.gov/study/NCT01150331"]}],"summary":"Clonazepam row mostly matches FDA labeling for identity, U.S. availability, formulation, mechanism, metabolism, half-life, labeled seizure indications, and adult seizure dosing maximum. Updates are needed for the DailyMed black-box source, overbroad epilepsy wording, enzyme-effect wording, unsupported 7% salivation frequency, untrusted evidence_sources, and misleading RCT notes/links. The two PubMed links do not support clonazepam-vs-placebo RR50/MPC/seizure-freedom outcomes; the current NR outcome fields are therefore appropriate."}
