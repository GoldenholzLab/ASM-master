ied","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://www.accessdata.fda.gov/scripts/opdlisting/oopd/detailedIndex.cfm?cfgridkey=266108"]},{"current_value":"2018","field":"year_fda_cleared","proposed_value":"2018","rationale":"FDA label states initial U.S. approval 2018; FDA orphan listing gives marketing approval date 08/20/2018.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://www.accessdata.fda.gov/scripts/opdlisting/oopd/detailedIndex.cfm?cfgridkey=266108"]},{"current_value":"Dravet","field":"epilepsy_type","proposed_value":"Dravet","rationale":"FDA indication is treatment of seizures associated with Dravet syndrome in patients taking clobazam who are 6 months or older and weigh at least 7 kg.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Capsule; powder for oral suspension","field":"formulations_available","proposed_value":"Capsule; powder for oral suspension","rationale":"FDA label lists capsules and powder for oral suspension, each in 250 mg and 500 mg strengths.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Capsule; Liquid; Sprinkle/powder","field":"filter_formulation","proposed_value":"Capsule; Powder for oral suspension","rationale":"The marketed product is not a ready-made liquid; FDA labeling lists capsules and powder for oral suspension.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"50 mg/kg/day; capped/adjusted by labeling and tolerability","field":"maximum_approved_daily_dose","proposed_value":"50 mg/kg/day; maximum recommended total dosage 3,000 mg/day","rationale":"FDA label states recommended oral dosage is 50 mg/kg/day and maximum recommended total dosage is 3,000 mg/day.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Dravet: 50 mg/kg/day divided BID/TID with clobazam/valproate","field":"typical_doses_per_day","proposed_value":"Dravet: 50 mg/kg/day divided BID/TID with clobazam; pivotal trials used clobazam and valproate background therapy","rationale":"Current U.S. labeling requires concomitant clobazam, while the pivotal studies enrolled patients inadequately controlled on clobazam and valproate.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"50 mg/kg/day target regimen with clobazam/valproate","field":"minimum_effective_dose","proposed_value":"50 mg/kg/day target regimen; current U.S. indication is with clobazam, and pivotal trials used clobazam plus valproate background therapy","rationale":"The 50 mg/kg/day regimen is label-supported, but valproate is trial background therapy rather than a current U.S. labeled requirement.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://pubmed.ncbi.nlm.nih.gov/11089822/"]},{"current_value":"4.5-13 h; dose-dependent","field":"half_life_range","proposed_value":"4.5-13 h; dose-dependent","rationale":"FDA pharmacokinetics section states elimination half-life ranges from 4.5 to 13 hours and increases with dose.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Liver","field":"major_organ_for_metabolism","proposed_value":"Liver","rationale":"FDA label states the drug is mainly metabolized by the liver.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Potent inhibitor of CYP3A4, CYP2C19, CYP2D6 and other pathways","field":"enzyme_inducing_or_inhibiting","proposed_value":"Mixed CYP/transporter inhibitor and inducer: FDA label states stiripentol inhibits and induces CYP1A2, CYP2B6, and CYP3A4, and inhibits CYP2C8, CYP2C19, P-gp, and BCRP; CYP2D6 inhibition is literature-reported but not listed in the FDA label.","rationale":"The current wording overstates potency and omits FDA-labeled induction effects. FDA labeling supports CYP3A4/CYP2C19 inhibition and additional CYP/transporter effects, but not the exact current phrasing.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://pmc.ncbi.nlm.nih.gov/articles/PMC7358047/"]},{"current_value":"Inhibitor","field":"filter_enzyme_effect","proposed_value":"Mixed inhibitor/inducer","rationale":"FDA label describes both inhibition and induction for selected CYP enzymes; a pure inhibitor filter is incomplete.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Human anticonvulsant mechanism is unknown; possible mechanisms include direct GABA-A receptor effects and indirect CYP inhibition that increases clobazam and norclobazam exposure.","field":"mechanism_of_action","proposed_value":"Human anticonvulsant mechanism is unknown; possible mechanisms include direct GABA-A receptor effects and indirect CYP inhibition that increases clobazam and norclobazam exposure.","rationale":"FDA label uses this same mechanism framing.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"FDA/DailyMed labeling","field":"mechanism_source","proposed_value":"FDA prescribing information (accessdata.fda.gov label 207223s006lbl, revised 04/2026)","rationale":"The mechanism is FDA-label supported, but the source should not be named as DailyMed when a direct FDA label URL is available.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Moderate","field":"mechanism_confidence","proposed_value":"Moderate","rationale":"Moderate confidence is appropriate because FDA labeling states the human anticonvulsant mechanism is unknown but lists plausible mechanisms.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"No clinically meaningful QT effect established","field":"qt_interval_effect","proposed_value":"No QT-specific effect statement identified in current FDA prescribing information.","rationale":"The FDA label states there are no relevant pharmacodynamic data, but I did not find a QT-specific statement establishing no meaningful QT effect.","requires_user_approval":false,"status":"insufficient_evidence","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"No known meaningful QT effect","field":"filter_qt_effect","proposed_value":"No QT-specific FDA-label statement identified","rationale":"The current FDA label does not support a specific no-meaningful-QT-effect classification.","requires_user_approval":false,"status":"insufficient_evidence","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"CNS: somnolence 67%, GI: decreased appetite 46%, GI: weight decreased 27%, neurologic: ataxia 27%, GI: nausea 15%, hematologic: neutropenia 13%","field":"adverse_symptoms_percentages","proposed_value":"CNS: somnolence 67%, GI/metabolism: decreased appetite 46%, weight decreased 27%, neurologic: ataxia 27%, GI: nausea 15%, hematologic: neutropenia 13%","rationale":"Percentages are FDA-label supported; category wording for decreased appetite/weight decreased is better aligned with the label table and warnings.","requires_user_approval":false,"status":"verified","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA prescribing information (accessdata.fda.gov label 207223s006lbl, revised 04/2026); FDA Orphan Drug Designations and Approvals; NCBI LiverTox Stiripentol; PubMed RCT records","rationale":"DailyMed is impermissible for boxed-warning verification and Epilepsy Society is not in the trusted-source allowlist. FDA/NCBI/PubMed sources support the retained row facts more directly.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://www.accessdata.fda.gov/scripts/opdlisting/oopd/detailedIndex.cfm?cfgridkey=266108","https://www.ncbi.nlm.nih.gov/books/NBK548951/"]}],"generic_name":"stiripentol","missing_rcts":[],"outcome_checks":[{"current_value":"65-66 % (drug minus placebo RR50 differential at maximum effective dose/regimen: Guerrini2024 stiripentol add-on to clobazam/valproate 65%; Chiron2000 stiripentol add-on to valproate and clobazam 66%)","field":"diff_50_responder_maximum_effective_dose","proposed_value":"65-66 % (drug minus placebo RR50 differential at maximum effective dose/regimen: Guerrini2024 pooled STICLO stiripentol add-on to clobazam/valproate 65%; Chiron2000/STICLO France stiripentol add-on to valproate and clobazam 66%)","rationale":"Chiron2000 reports 71% responders on stiripentol vs 5% placebo. Guerrini2024 reports pooled STICLO 72% vs 7%.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/11089822/","https://pubmed.ncbi.nlm.nih.gov/38722572/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"76 % (drug minus placebo MPC differential at maximum effective dose/regimen: Chiron2000 stiripentol add-on to valproate and clobazam 76%)","field":"diff_median_pct_change_maximum_effective_dose","proposed_value":"98.4 % (drug minus placebo median percentage-change differential at maximum effective dose/regimen: Chiron2000/STICLO France stiripentol add-on to valproate and clobazam, computed from median -91% on stiripentol vs +7.4% on placebo)","rationale":"The 76% value matches the mean percentage-change contrast in the Chiron2000/FDA data (-69% vs about +7%), not the median percentage-change contrast. FDA Table 5 lists median -91% for stiripentol and +7.4% for placebo in Study 1.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/11089822/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"38-42.9 % (drug minus placebo seizure-freedom differential at maximum effective dose/regimen: Guerrini2024 stiripentol add-on to clobazam/valproate 38%; Chiron2000 stiripentol add-on to valproate and clobazam 42.9%)","field":"diff_seizure_freedom_maximum_effective_dose","proposed_value":"38-42.9 % (drug minus placebo seizure-freedom differential at maximum effective dose/regimen: Guerrini2024 pooled STICLO stiripentol add-on to clobazam/valproate 38%; Chiron2000/STICLO France stiripentol add-on to valproate and clobazam 42.9%)","rationale":"Chiron2000 reports 9/21 stiripentol patients seizure-free and 0 placebo; Guerrini2024 reports pooled 38% stiripentol vs 0% placebo.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/11089822/","https://pubmed.ncbi.nlm.nih.gov/38722572/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Guerrini2024|65|https://pubmed.ncbi.nlm.nih.gov/38722572/|64; Chiron2000|66|https://pubmed.ncbi.nlm.nih.gov/11089822/|41","field":"plot_diff_50_responder_maximum_effective_dose","proposed_value":"Guerrini2024|65|https://pubmed.ncbi.nlm.nih.gov/38722572/|64; Chiron2000|66|https://pubmed.ncbi.nlm.nih.gov/11089822/|41","rationale":"Plot values match the cited responder-rate differentials and sample sizes.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/38722572/","https://pubmed.ncbi.nlm.nih.gov/11089822/"]},{"current_value":"Chiron2000|76|https://pubmed.ncbi.nlm.nih.gov/11089822/|41","field":"plot_diff_median_pct_change_maximum_effective_dose","proposed_value":"Chiron2000|98.4|https://pubmed.ncbi.nlm.nih.gov/11089822/|41","rationale":"The plotted value should match median percentage-change differential, not mean percentage-change differential.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/11089822/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Guerrini2024|38|https://pubmed.ncbi.nlm.nih.gov/38722572/|64; Chiron2000|42.9|https://pubmed.ncbi.nlm.nih.gov/11089822/|41","field":"plot_diff_seizure_freedom_maximum_effective_dose","proposed_value":"Guerrini2024|38|https://pubmed.ncbi.nlm.nih.gov/38722572/|64; Chiron2000|42.9|https://pubmed.ncbi.nlm.nih.gov/11089822/|41","rationale":"Plot values match the cited seizure-freedom differentials and sample sizes.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubmed.ncbi.nlm.nih.gov/38722572/","https://pubmed.ncbi.nlm.nih.gov/11089822/"]}],"overall_status":"needs_update","proposed_row_updates":[{"current_value":"FDA/DailyMed SPL; status=no_boxed_warning_in_selected_label; setid=58304ba8-9779-4658-811e-94ffe08c3f16; published=Apr 30, 2026; title=DIACOMIT (STIRIPENTOL) CAPSULE DIACOMIT (STIRIPENTOL) POWDER, FOR SUSPENSION [BIOCODEX, INC.]; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=58304ba8-9779-4658-811e-94ffe08c3f16","field":"fda_black_box_warning_source","proposed_value":"FDA prescribing information; status=no_boxed_warning_identified_in_current_fda_label; application=NDA 207223; label=207223s006lbl; revised=04/2026; url=https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf; openFDA_api_url=https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%2258304ba8-9779-4658-811e-94ffe08c3f16%22&limit=5","reason":"DailyMed is not permissible for the boxed-warning field; FDA label/openFDA should be used.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%2258304ba8-9779-4658-811e-94ffe08c3f16%22&limit=5"]},{"current_value":"No FDA boxed warning identified in selected current DailyMed label.","field":"fda_black_box_warning","proposed_value":"No FDA boxed warning identified in current FDA prescribing information.","reason":"Fact is supportable, but the current wording cites an impermissible DailyMed check.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"05-20-2026","field":"fda_black_box_warning_verified","proposed_value":"05-21-2026","reason":"Refresh date should reflect this FDA-source audit date.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA prescribing information (accessdata.fda.gov label 207223s006lbl, revised 04/2026); FDA Orphan Drug Designations and Approvals; NCBI LiverTox Stiripentol; PubMed RCT records","reason":"Replaces non-allowlisted/impermissible source naming with trusted sources that directly support row facts.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://www.accessdata.fda.gov/scripts/opdlisting/oopd/detailedIndex.cfm?cfgridkey=266108","https://www.ncbi.nlm.nih.gov/books/NBK548951/"]},{"current_value":"FDA/DailyMed labeling","field":"mechanism_source","proposed_value":"FDA prescribing information (accessdata.fda.gov label 207223s006lbl, revised 04/2026)","reason":"Mechanism is FDA-label supported; use the direct FDA source.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Potent inhibitor of CYP3A4, CYP2C19, CYP2D6 and other pathways","field":"enzyme_inducing_or_inhibiting","proposed_value":"Mixed CYP/transporter inhibitor and inducer: FDA label states stiripentol inhibits and induces CYP1A2, CYP2B6, and CYP3A4, and inhibits CYP2C8, CYP2C19, P-gp, and BCRP; CYP2D6 inhibition is literature-reported but not listed in the FDA label.","reason":"Current wording is oversimplified and not fully FDA-label concordant.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://pmc.ncbi.nlm.nih.gov/articles/PMC7358047/"]},{"current_value":"76 % (drug minus placebo MPC differential at maximum effective dose/regimen: Chiron2000 stiripentol add-on to valproate and clobazam 76%)","field":"diff_median_pct_change_maximum_effective_dose","proposed_value":"98.4 % (drug minus placebo median percentage-change differential at maximum effective dose/regimen: Chiron2000/STICLO France stiripentol add-on to valproate and clobazam, computed from median -91% on stiripentol vs +7.4% on placebo)","reason":"The current 76% is a mean percentage-change contrast, not the median contrast requested by the field name.","requires_user_approval":false,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/11089822/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Chiron2000|76|https://pubmed.ncbi.nlm.nih.gov/11089822/|41","field":"plot_diff_median_pct_change_maximum_effective_dose","proposed_value":"Chiron2000|98.4|https://pubmed.ncbi.nlm.nih.gov/11089822/|41","reason":"Plot value should match median percentage-change differential.","requires_user_approval":false,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/11089822/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Guerrini2024|https://pubmed.ncbi.nlm.nih.gov/38722572/; Nabbout2020|https://pubmed.ncbi.nlm.nih.gov/31790543/; Chiron2006|https://pubmed.ncbi.nlm.nih.gov/16948934/; Chiron2000|https://pubmed.ncbi.nlm.nih.gov/11089822/","field":"pubmed_phase_ii_iii_rct_links","proposed_value":"Guerrini2024|https://pubmed.ncbi.nlm.nih.gov/38722572/; Chiron2006|https://pubmed.ncbi.nlm.nih.gov/16948934/; Chiron2000|https://pubmed.ncbi.nlm.nih.gov/11089822/","reason":"Nabbout2020 randomized fenfluramine vs placebo; stiripentol was background therapy, so it is the wrong active drug for this stiripentol RCT list. This is a direct contradiction and needs user approval before removal.","requires_user_approval":true,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/31790543/","https://clinicaltrials.gov/study/NCT02926898"]},{"current_value":"No clinically meaningful QT effect established","field":"qt_interval_effect","proposed_value":"No QT-specific effect statement identified in current FDA prescribing information.","reason":"FDA label does not provide a QT-specific no-effect statement.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]},{"current_value":"Capsule; Liquid; Sprinkle/powder","field":"filter_formulation","proposed_value":"Capsule; Powder for oral suspension","reason":"FDA label supports capsules and powder for oral suspension, not a ready-made liquid formulation.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf"]}],"rct_link_checks":[{"label":"Guerrini2024","pmid":"38722572","proposed_action":"retain, but describe as a post-hoc pooled report of STICLO phase 3 randomized placebo-controlled stiripentol trials rather than a separate independent RCT","rationale":"Reports additional outcomes from two randomized, double-blind, placebo-controlled phase 3 stiripentol STICLO studies in Dravet syndrome; active drug is stiripentol.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/38722572/"},{"label":"Nabbout2020","pmid":"31790543","proposed_action":"remove from stiripentol active-drug RCT list or move to background-therapy notes; requires user approval","rationale":"This was a randomized trial of fenfluramine 0.4 mg/kg/day vs placebo in patients receiving stiripentol-inclusive regimens. Stiripentol was not the randomized active treatment.","status":"wrong_drug","url":"https://pubmed.ncbi.nlm.nih.gov/31790543/"},{"label":"Chiron2006","pmid":"16948934","proposed_action":"retain only if the CSV field allows placebo-controlled stiripentol seizure RCTs beyond Dravet and without explicit PubMed phase tagging; otherwise review field scope","rationale":"PubMed verifies a randomized placebo-controlled enrichment/withdrawal trial of stiripentol in childhood partial epilepsy, but the abstract does not state phase II/III and it is not a Dravet maximum-dose outcome source.","status":"insufficient_evidence","url":"https://pubmed.ncbi.nlm.nih.gov/16948934/"},{"label":"Chiron2000","pmid":"11089822","proposed_action":"retain","rationale":"PubMed verifies a randomized placebo-controlled add-on stiripentol trial in severe myoclonic epilepsy in infancy/Dravet with valproate and clobazam background therapy; FDA label uses this pivotal evidence.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/11089822/"}],"source_updates":[{"current_value":"FDA/DailyMed SPL; status=no_boxed_warning_in_selected_label; setid=58304ba8-9779-4658-811e-94ffe08c3f16; published=Apr 30, 2026; title=DIACOMIT (STIRIPENTOL) CAPSULE DIACOMIT (STIRIPENTOL) POWDER, FOR SUSPENSION [BIOCODEX, INC.]; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=58304ba8-9779-4658-811e-94ffe08c3f16","field":"fda_black_box_warning_source","proposed_value":"FDA prescribing information; status=no_boxed_warning_identified_in_current_fda_label; application=NDA 207223; label=207223s006lbl; revised=04/2026; url=https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf; openFDA_api_url=https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%2258304ba8-9779-4658-811e-94ffe08c3f16%22&limit=5","reason":"Use FDA/openFDA, not DailyMed, for the boxed-warning field.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%2258304ba8-9779-4658-811e-94ffe08c3f16%22&limit=5"]},{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA prescribing information (accessdata.fda.gov label 207223s006lbl, revised 04/2026); FDA Orphan Drug Designations and Approvals; NCBI LiverTox Stiripentol; PubMed RCT records","reason":"Align row evidence with trusted-source policy and direct support for facts.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2026/207223s006lbl.pdf","https://www.accessdata.fda.gov/scripts/opdlisting/oopd/detailedIndex.cfm?cfgridkey=266108","https://www.ncbi.nlm.nih.gov/books/NBK548951/"]}],"summary":"Stiripentol/Diacomit identity, U.S. availability, 2018 FDA approval, Dravet indication, formulation, dose, half-life, liver metabolism, adverse-event percentages, RR50, and seizure-freedom values are largely supported. Updates are needed for DailyMed-based boxed-warning/source fields, the enzyme-effect wording, formulation and QT filters, the median-percent-change outcome, and Nabbout2020, which is a fenfluramine trial with stiripentol as background therapy."}
