urces":["https://pubmed.ncbi.nlm.nih.gov/31111774/"]},{"current_value":"","field":"plot_diff_50_responder_maximum_effective_dose","proposed_value":"","rationale":"Plot field should remain blank when the differential RCT value is N/A.","requires_user_approval":false,"status":"not_applicable","supporting_sources":[]},{"current_value":"","field":"plot_diff_median_pct_change_maximum_effective_dose","proposed_value":"","rationale":"Plot field should remain blank when the differential RCT value is N/A.","requires_user_approval":false,"status":"not_applicable","supporting_sources":[]},{"current_value":"","field":"plot_diff_seizure_freedom_maximum_effective_dose","proposed_value":"","rationale":"Plot field should remain blank when the differential RCT value is N/A.","requires_user_approval":false,"status":"not_applicable","supporting_sources":[]}],"overall_status":"needs_update","proposed_row_updates":[{"current_value":"bromide; kaliumbromid","field":"alternate_generic_names","proposed_value":"kaliumbromid; KBr; kalii bromidum; kali bromatum","reason":"Use exact synonyms; move broad 'bromide' to search aliases only.","requires_user_approval":false,"source_urls":["https://pubchem.ncbi.nlm.nih.gov/compound/Potassium-Bromide"]},{"current_value":"DIBRO-BE mono; Kaliumbromid DESITIN","field":"trade_names","proposed_value":"DIBRO-BE mono; Kaliumbromid DESITIN; KBroVet; KBroVet-CA1 (veterinary, US)","reason":"FDA sources verify KBroVet/KBroVet-CA1 as same active ingredient in a US veterinary seizure product; retaining DIBRO-BE mono pending a trusted source avoids unsupported deletion.","requires_user_approval":false,"source_urls":["https://www.fda.gov/animal-veterinary/cvm-updates/fda-grants-full-approval-drug-control-seizures-dogs-idiopathic-epilepsy","https://animaldrugsatfda.fda.gov/adafda/app/search/public/document/downloadFoi/17867"]},{"current_value":"No - not available in U.S. for seizure control; German nationally authorized product information identified.","field":"available_in_us","proposed_value":"No for FDA-approved human seizure control; however, FDA granted full approval to veterinary KBroVet (potassium bromide chewable tablets) for control of seizures associated with idiopathic epilepsy in dogs on January 21, 2026. German nationally authorized human product information is identified.","reason":"Current text is overbroad after 2026 FDA veterinary approval.","requires_user_approval":true,"source_urls":["https://www.fda.gov/animal-veterinary/cvm-updates/fda-grants-full-approval-drug-control-seizures-dogs-idiopathic-epilepsy","https://animaldrugsatfda.fda.gov/adafda/app/search/public/document/downloadFoi/17867"]},{"current_value":"Dermatologic: bromacne about 25%; CNS: fatigue rare at low bromide levels and more common with higher levels (1-10% category); GI: coated tongue/mouth odor/aphthae/constipation/diarrhea rare (0.01-0.1% category); GI: gastritis/ulcer/pancreatitis very rare (<0.01% category); respiratory: rhinitis/bronchitis/sinusitis frequency not estimable (0% exact percentage unavailable).","field":"adverse_symptoms_percentages","proposed_value":"Dermatologic: papulopustular skin changes/bromacne very common, about 25%; CNS: fatigue and psychomotor slowing are serum-level related, with fatigue rare at low bromide levels and more frequent at middle/high levels, but exact percentages are not provided; GI: coated tongue, mouth odor, aphthae, constipation, or diarrhea rare (>=0.01% to <0.1%); GI: gastritis, ulcers/perforation, and pancreatitis very rare (<0.01%); Respiratory: serous rhinitis, mucus hypersecretion, bronchitis, sinusitis, and asthma exacerbation can occur, frequency not estimable from available data.","reason":"Removes unsupported CNS 1-10% category and confusing 0% respiratory wording.","requires_user_approval":false,"source_urls":["https://www.desitin.de/wp-content/uploads/2020/01/Kaliumbromid-DESITIN-850-mg-Tabletten.pdf"]},{"current_value":"No pharmacologic interaction with other ASMs described; not a CYP inducer/inhibitor; bromide clearance affected by chloride/salt balance and diuretics.","field":"enzyme_inducing_or_inhibiting","proposed_value":"No pharmacological interactions with other antiseizure medications are described in the German Fachinformation; bromide is not metabolized and is excreted unchanged, mainly renally; bromide levels/half-life are affected by chloride/salt balance and diuretics.","reason":"CYP-specific statement is not directly supported by the cited source.","requires_user_approval":false,"source_urls":["https://www.desitin.de/wp-content/uploads/2020/01/Kaliumbromid-DESITIN-850-mg-Tabletten.pdf"]},{"current_value":"EMA/UK SmPC","field":"mechanism_source_tier","proposed_value":"German national Fachinformation / manufacturer product information (not EMA/UK SmPC)","reason":"The mechanism source is a German Desitin Fachinformation PDF, not EMA/eMC/UK SmPC.","requires_user_approval":false,"source_urls":["https://www.desitin.de/wp-content/uploads/2020/01/Kaliumbromid-DESITIN-850-mg-Tabletten.pdf"]},{"current_value":"Not FDA-cleared; German Kaliumbromid DESITIN authorization 07.01.2019 in Fachinformation.","field":"year_fda_cleared","proposed_value":"Not FDA-approved for human seizure control; FDA granted full approval to veterinary KBroVet (potassium bromide chewable tablets) for dogs on January 21, 2026; German Kaliumbromid DESITIN authorization date 07.01.2019.","reason":"Clarifies human versus veterinary FDA approval status and preserves German authorization date.","requires_user_approval":true,"source_urls":["https://www.fda.gov/animal-veterinary/cvm-updates/fda-grants-full-approval-drug-control-seizures-dogs-idiopathic-epilepsy","https://animaldrugsatfda.fda.gov/adafda/app/search/public/document/downloadFoi/17867","https://www.desitin.de/wp-content/uploads/2020/01/Kaliumbromid-DESITIN-850-mg-Tabletten.pdf"]}],"rct_link_checks":[{"label":"local audit candidate Garcia 2022","pmid":"35967998","proposed_action":"Keep rejected; do not add to pubme