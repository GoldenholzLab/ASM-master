posed_value":"Lee2025|49.8|https://pubmed.ncbi.nlm.nih.gov/41144696/|519; Chung2020|19.5|https://pubmed.ncbi.nlm.nih.gov/32409485/|222; Krauss2019|20.1|https://pubmed.ncbi.nlm.nih.gov/31734103/|437","reason":"Add Krauss2019 seizure-freedom plot point.","requires_user_approval":false,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/31734103/","https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/212839s013lbl.pdf"]},{"current_value":"Lee2025|https://pubmed.ncbi.nlm.nih.gov/41144696/; Vossler2020|https://pubmed.ncbi.nlm.nih.gov/32313503/; Chung2020|https://pubmed.ncbi.nlm.nih.gov/32409485/; Krauss2019|https://pubmed.ncbi.nlm.nih.gov/31734103/; KasteleijnNolstTrenite2019|https://pubmed.ncbi.nlm.nih.gov/31292226/","field":"pubmed_phase_ii_iii_rct_links","proposed_value":"Lee2025|https://pubmed.ncbi.nlm.nih.gov/41144696/; Chung2020|https://pubmed.ncbi.nlm.nih.gov/32409485/; Krauss2019|https://pubmed.ncbi.nlm.nih.gov/31734103/; KasteleijnNolstTrenite2019|https://pubmed.ncbi.nlm.nih.gov/31292226/","reason":"Vossler2020 is a Comment/editorial about a trial, not a placebo-controlled RCT report. Removal of an existing entry requires user approval.","requires_user_approval":true,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/32313503/","https://pubmed.ncbi.nlm.nih.gov/31734103/"]},{"current_value":"PubMed loop 8/65 on 2026-05-15: 5 qualifying placebo-controlled randomized clinical trial report(s) retained from 22 PubMed candidate(s). Links were rebuilt from fetched PubMed PMID metadata and named FirstAuthorYear. Differential effectiveness columns summarize extractable maximum effective dose/regimen values within qualifying RCT reports.","field":"rct_pubmed_verification_notes","proposed_value":"Audit 05-20-2026: PubMed links verified for cenobamate/YKP3089. Lee2025, Chung2020, Krauss2019, and KasteleijnNolstTrenite2019 are qualifying placebo-controlled phase II/III randomized trial reports or proof-of-principle reports; Vossler2020 PMID 32313503 is a Comment/editorial and should not be counted as an RCT report. KasteleijnNolstTrenite2019 is a phase 2 photosensitivity/PPR proof-of-principle study and should not be used for focal-seizure RR50/MPC/seizure-freedom outcomes. Secondary reports from NCT04557085 include Kawai2025 PMID 41230998, Wu2025 PMID 41101116, and Yu2025 PMID 41428177; include only if secondary RCT reports are in scope.","reason":"Update verification notes to reflect RCT concordance and secondary-report status.","requires_user_approval":true,"source_urls":["https://pubmed.ncbi.nlm.nih.gov/41144696/","https://pubmed.ncbi.nlm.nih.gov/32313503/","https://pubmed.ncbi.nlm.nih.gov/32409485/","https://pubmed.ncbi.nlm.nih.gov/31734103/","https://pubmed.ncbi.nlm.nih.gov/31292226/","https://pubmed.ncbi.nlm.nih.gov/41230998/","https://pubmed.ncbi.nlm.nih.gov/41101116/","https://pubmed.ncbi.nlm.nih.gov/41428177/"]}],"rct_link_checks":[{"label":"Lee2025","pmid":"41144696","proposed_action":"Retain. Label is acceptable if using epub year 2025; print issue is 2026.","rationale":"PubMed identifies cenobamate, randomized controlled trial, double-blind placebo-controlled NCT04557085 in focal seizures, with placebo and 100/200/400 mg/day arms. ClinicalTrials.gov identifies NCT04557085 as phase 3.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/41144696/"},{"label":"Vossler2020","pmid":"32313503","proposed_action":"Remove from pubmed_phase_ii_iii_rct_links or move to non-RCT commentary notes; requires user approval because it removes an existing entry.","rationale":"PMID 32313503 is a Comment/editorial article discussing the Krauss trial, not the original randomized placebo-controlled trial report. It should not be counted as a phase II/III placebo-controlled RCT link.","status":"not_placebo_rct","url":"https://pubmed.ncbi.nlm.nih.gov/32313503/"},{"label":"Chung2020","pmid":"32409485","proposed_action":"Retain.","rationale":"Phase 2 multicenter double-blind randomized placebo-controlled adjunctive cenobamate/YKP3089 trial in uncontrolled focal seizures; ClinicalTrials.gov NCT01397968 lists phase 2 and placebo control.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/32409485/"},{"label":"Krauss2019","pmid":"31734103","proposed_action":"Retain.","rationale":"PubMed abstract describes a multicenter, double-blind, randomized, placebo-controlled dose-response trial of adjunctive cenobamate/YKP3089 in uncontrolled focal seizures; ClinicalTrials.gov NCT01866111 lists phase 2 placebo-controlled design.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/31734103/"},{"label":"KasteleijnNolstTrenite2019","pmid":"31292226","proposed_action":"Retain only as a phase 2 photosensitivity/PPR proof-of-principle placebo-controlled randomized study; do not use for focal-seizure RR50/MPC/seizure-freedom outcome fields.","rationale":"ClinicalTrials.gov NCT00616148 lists a phase 2 YKP3089/placebo photosensitive epilepsy study, and PubMed identifies a randomized controlled phase II report. Its endpoint is photoparoxysmal response suppression, not clinical focal seizure-frequency outcomes.","status":"verified","url":"https://pubmed.ncbi.nlm.nih.gov/31292226/"}],"source_updates":[{"current_value":"NCBI LiverTox anticonvulsants table; Epilepsy Society ASM list; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA label (Xcopri Prescribing Information, accessdata.fda.gov); Drugs@FDA approval letter; FDA/openFDA label API for boxed-warning status; PubMed and ClinicalTrials.gov RCT records; EMA EPAR and eMC SmPC for Ontozry","reason":"Current sources do not meet the trusted-source policy for all row facts and omit RCT/non-US brand sources.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/212839s013lbl.pdf","https://www.accessdata.fda.gov/drugsatfda_docs/appletter/2019/212839Orig1s000ltr.pdf","https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%22565c2126-57ae-4e29-b443-723bbe7e2072%22&limit=5","https://www.ema.europa.eu/en/medicines/human/EPAR/ontozry","https://www.medicines.org.uk/emc/product/13008/smpc"]},{"current_value":"FDA/DailyMed labeling","field":"mechanism_source","proposed_value":"FDA label (Xcopri Prescribing Information)","reason":"Use the FDA label URL directly for mechanism support.","requires_user_approval":false,"source_urls":["https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/212839s013lbl.pdf"]},{"current_value":"FDA/DailyMed SPL; status=no_boxed_warning_in_selected_label; setid=565c2126-57ae-4e29-b443-723bbe7e2072; published=Feb 02, 2026; title=XCOPRI TITRATION PACK (CENOBAMATE) KIT XCOPRI (CENOBAMATE) TABLET, FILM COATED XCOPRI MAINTENANCE PACK (CENOBAMATE) KIT XCOPRI (CENOBAMATE) TABLET [SK LIFE SCIENCE, INC.]; url=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=565c2126-57ae-4e29-b443-723bbe7e2072","field":"fda_black_box_warning_source","proposed_value":"FDA/openFDA drug label API and FDA Xcopri Prescribing Information; status=no_boxed_warning_in_selected_fda_label; spl_set_id=565c2126-57ae-4e29-b443-723bbe7e2072; effective_time=20250925; title=Xcopri; Xcopri Maintenance Pack; Xcopri Titration Pack / CENOBAMATE; api_url=https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%22565c2126-57ae-4e29-b443-723bbe7e2072%22&limit=5; fda_label_url=https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/212839s013lbl.pdf","reason":"FDA boxed-warning field must be verified from FDA/openFDA/FDA label/Drugs@FDA only.","requires_user_approval":false,"source_urls":["https://api.fda.gov/drug/label.json?search=openfda.spl_set_id%3A%22565c2126-57ae-4e29-b443-723bbe7e2072%22&limit=5","https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/212839s013lbl.pdf"]}],"summary":"Cenobamate row mostly matches FDA/EMA/PubMed evidence, but it needs updates: black-box warning source must be changed from DailyMed to FDA/openFDA/FDA label, adverse percentages for fatigue/diplopia are wrong, enzyme-effect text overstates UGT induction, RR50 is missing Lee2025 maximum-dose data, seizure-freedom plotting is missing Krauss2019 data, and Vossler2020 is a commentary rather than a qualifying RCT report. Trade names Xcopri/Ontozry and alias YKP3089 are correctly handled as aliases, not separate drug rows."}
