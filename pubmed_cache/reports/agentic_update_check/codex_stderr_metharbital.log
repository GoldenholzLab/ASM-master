files"]},{"current_value":"Historical/unspecified epilepsy (specific FDA-labeled seizure category not available from Orange Book listing)","field":"epilepsy_type","proposed_value":"Historical/unspecified epilepsy (specific FDA-labeled seizure category not available from Orange Book listing)","rationale":"No current FDA label was identified to support a specific seizure subtype. PubChem supports historical epilepsy use, but not a specific FDA-labeled seizure category.","requires_user_approval":false,"status":"verified","supporting_sources":["https://pubchem.ncbi.nlm.nih.gov/compound/Metharbital","https://open.fda.gov/apis/drug/label/"]},{"current_value":"FDA Orange Book products file; FDA/DailyMed labeling","field":"evidence_sources","proposed_value":"FDA Orange Book products file; FDA/openFDA labeling API; NCBI PubChem/MeSH aliases","rationale":"DailyMed should not be used for boxed-warning verification, and the row now needs an explicit NCBI/PubChem alias source. openFDA is the appropriate FDA label-search source for the no-current-label finding.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://www.fda.gov/drugs/drug-approvals-and-databases/orange-book-data-files","https://open.fda.gov/apis/drug/label/","https://pubchem.ncbi.nlm.nih.gov/compound/Metharbital"]},{"current_value":"N/A - no current FDA/DailyMed label located; FDA Orange Book confirms historical U.S. product approval/listing but does not provide mechanism of action.","field":"mechanism_of_action","proposed_value":"N/A - no current FDA/openFDA label located; FDA Orange Book confirms historical U.S. product approval/listing but does not provide mechanism of action.","rationale":"The substantive N/A mechanism conclusion is supported by absence of a current FDA label and Orange Book field limitations, but source wording should be FDA/openFDA rather than FDA/DailyMed.","requires_user_approval":false,"status":"incorrect","supporting_sources":["https://open.fda.gov/apis/drug/