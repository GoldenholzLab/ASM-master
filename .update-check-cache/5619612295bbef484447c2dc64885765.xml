               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>Inactive Ingredients</title>
               <text>
                  <paragraph>water, coco-caprylate/caprate, butyloctyl salicylate, caprylic/capric triglyceride, octyldodecyl neopentanoate, methyl glycose sesquistearate, silica, glyceryl stearate, PEG-100 stearate, PEG-20 methyl glycose sesquistearate, phenoxyethanol, triethoxycaprylylsilane, polyhydroxystearic acid, glycerin, glyceryl behenate, saccharide isomerate, xanthan gum, zingiber officinale (Ginger) root extract, hydroxyethyl acrylate/sodium acryloyldimethyl taurate copoylmer, squalane, diemthicone, ethylhexylglycerin, tetrahexyldecyl ascorbate, tocopheryl acetate, sclerotium gum, lecithin, pullulan, polysorbate 60, tocopherol, mica, iron oxides</paragraph>
               </text>
               <effectiveTime value="20260403"/>
