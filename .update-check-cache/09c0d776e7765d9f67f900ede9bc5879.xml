                     <id root="4882ff99-b92b-693b-e063-6394a90a4476"/>
                     <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Store at 20°-25°C (68°-77°F)</content>[see USP Controlled Room Temperature].

 </paragraph>
                     </text>
                     <effectiveTime value="20191120"/>
                  </section>
               </component>
            </section>
